@page "/"
@attribute [Authorize]
@inject CurrentUserService CurrentUser
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Nav_Home"] — KPG Timesheet</PageTitle>

<section class="home-page" aria-labelledby="home-title">
    <AuthorizeView>
        <Authorized>
            <KpgPageHeader Title="@L["Home_Welcome"]"
                           Subtitle="@(context.User.FindFirst("email")?.Value ?? context.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? context.User.Identity?.Name)" />
        </Authorized>
    </AuthorizeView>

    <MudGrid Spacing="3" Class="home-actions">
        <AuthorizeView Roles="@($"{Roles.Empleado},{Roles.Supervisor},{Roles.Gerente},{Roles.Admin}")">
            <Authorized>
                <MudItem xs="12" sm="6" lg="4">
                    <a class="home-action-card" href="/registro" aria-label="@L["Home_GoToRegister"]">
                        <span class="home-action-card__icon home-action-card__icon--primary" aria-hidden="true"><MudIcon Icon="@Icons.Material.Filled.EditCalendar" /></span>
                        <span class="home-action-card__content">
                            <MudText Typo="Typo.h6" HtmlTag="h2">@L["Nav_Register"]</MudText>
                            <MudText Typo="Typo.body2">@L["Home_CardRegisterDesc"]</MudText>
                        </span>
                        <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Class="home-action-card__arrow" aria-hidden="true" />
                    </a>
                </MudItem>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="@($"{Roles.Supervisor},{Roles.Gerente},{Roles.Admin}")">
            <Authorized>
                <MudItem xs="12" sm="6" lg="4">
                    <a class="home-action-card" href="/dashboard" aria-label="@L["Home_GoToDashboard"]">
                        <span class="home-action-card__icon home-action-card__icon--info" aria-hidden="true"><MudIcon Icon="@Icons.Material.Filled.Dashboard" /></span>
                        <span class="home-action-card__content">
                            <MudText Typo="Typo.h6" HtmlTag="h2">@L["Nav_Dashboard"]</MudText>
                            <MudText Typo="Typo.body2">@L["Home_CardDashboardDesc"]</MudText>
                        </span>
                        <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Class="home-action-card__arrow" aria-hidden="true" />
                    </a>
                </MudItem>
                <MudItem xs="12" sm="6" lg="4">
                    <a class="home-action-card" href="/reportes/horas" aria-label="@L["Home_GoToReports"]">
                        <span class="home-action-card__icon home-action-card__icon--success" aria-hidden="true"><MudIcon Icon="@Icons.Material.Filled.BarChart" /></span>
                        <span class="home-action-card__content">
                            <MudText Typo="Typo.h6" HtmlTag="h2">@L["Nav_Reports"]</MudText>
                            <MudText Typo="Typo.body2">@L["Home_CardReportsDesc"]</MudText>
                        </span>
                        <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Class="home-action-card__arrow" aria-hidden="true" />
                    </a>
                </MudItem>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="@Roles.Admin">
            <Authorized>
                <MudItem xs="12" sm="6" lg="4">
                    <a class="home-action-card" href="/admin/usuarios" aria-label="@L["Home_GoToAdmin"]">
                        <span class="home-action-card__icon home-action-card__icon--warning" aria-hidden="true"><MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" /></span>
                        <span class="home-action-card__content">
                            <MudText Typo="Typo.h6" HtmlTag="h2">@L["Nav_Admin"]</MudText>
                            <MudText Typo="Typo.body2">@L["Home_CardAdminDesc"]</MudText>
                        </span>
                        <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Class="home-action-card__arrow" aria-hidden="true" />
                    </a>
                </MudItem>
            </Authorized>
        </AuthorizeView>
    </MudGrid>
</section>
