@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Routing
@implements IDisposable
@inject KpgAuthStateProvider AuthProvider
@inject SessionTimeoutService SessionTimeout
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L

<MudLayout Class="kpg-app-shell">
    <MudAppBar Elevation="0" Color="Color.Surface" Dense="false" Class="kpg-topbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Default"
                       Edge="Edge.Start"
                       aria-label="@L["Nav_Menu"]"
                       OnClick="ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="kpg-topbar-title">
            KPG Timesheet
        </MudText>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <MudMenu AnchorOrigin="Origin.BottomCenter"
                         TransformOrigin="Origin.TopCenter"
                         Class="d-none d-sm-block me-1">
                    <ActivatorContent>
                        <MudButton Color="Color.Default"
                                   EndIcon="@Icons.Material.Filled.ArrowDropDown"
                                   Class="kpg-user-menu-button">
                            <MudStack Spacing="0" AlignItems="AlignItems.Start">
                                <span>@NombreParaMostrar(context.User)</span>
                                @if (context.User.FindFirst("lider")?.Value is { Length: > 0 } lider)
                                {
                                    <MudText Typo="Typo.caption" Class="kpg-user-menu-caption">
                                        @L["Org_LedBy"] @lider
                                    </MudText>
                                }
                            </MudStack>
                        </MudButton>
                    </ActivatorContent>
                    <ChildContent>
                        <MudMenuItem Href="/perfil"
                                     Icon="@Icons.Material.Filled.AccountCircle">
                            Mi Perfil
                        </MudMenuItem>
                        <MudDivider />
                        <MudMenuItem OnClick="HandleLogout"
                                     Icon="@Icons.Material.Filled.Logout"
                                     IconColor="Color.Error">
                            Cerrar sesión
                        </MudMenuItem>
                    </ChildContent>
                </MudMenu>
                <KpgLanguageSelector />
                <MudIconButton Icon="@Icons.Material.Filled.Logout"
                               Color="Color.Default"
                               title="Cerrar sesión"
                               Class="d-sm-none"
                               OnClick="HandleLogout" />
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen"
               Variant="DrawerVariant.Responsive"
               Breakpoint="Breakpoint.Md"
               Elevation="0"
               Class="kpg-sidebar">
        <MudDrawerHeader Class="kpg-sidebar-brand">
            <img src="images/kpg-logo.jpg" alt="KPG" class="kpg-sidebar-logo" />
        </MudDrawerHeader>
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="kpg-main-content">
        @* Las pantallas de tablas necesitan todo el ancho: con el tope de lectura de
           1200px el renglon se corta y hay que hacer scroll horizontal. El resto lo
           conserva, porque un formulario o un texto a 2000px se lee mal. *@
        <MudContainer MaxWidth="MaxWidth.False" Class="kpg-content-container" Style="@EstiloContenedor">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<KpgSessionWarningDialog Visible="_showWarning"
                         ExpiresAt="_expiresAt"
                         OnContinueClicked="HandleSessionContinue"
                         OnLogoutClicked="HandleLogout" />

@code {
    /// <summary>
    /// Rutas con grillas anchas, que se ven mal recortadas a 1200px. Es una lista
    /// explicita y no una regla automatica: agregar una pantalla aqui debe ser una
    /// decision, no un efecto secundario.
    /// </summary>
    private static readonly string[] RutasAnchas =
    [
        "/mis-registros",
        "/aprobaciones",
        "/reportes",
        "/admin/bitacora",
        "/admin/usuarios",
        "/solicitudes-excepcion",
        "/mis-solicitudes"
    ];

    private string EstiloContenedor
    {
        get
        {
            var ruta = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].TrimEnd('/');
            return RutasAnchas.Any(r => ruta.Equals(r, StringComparison.OrdinalIgnoreCase)
                                        || ruta.StartsWith(r + "/", StringComparison.OrdinalIgnoreCase))
                ? "max-width:100%;"
                : "max-width:1200px;";
        }
    }

    private bool _drawerOpen = true;
    private bool _showWarning;
    private DateTime _expiresAt;

    /// <summary>
    /// Nombre del usuario para la barra superior. Cae al email para las cuentas
    /// creadas antes de que el nombre fuera obligatorio.
    /// </summary>
    private static string? NombreParaMostrar(System.Security.Claims.ClaimsPrincipal user)
    {
        var nombre = user.FindFirst("name")?.Value
                     ?? user.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value;

        if (!string.IsNullOrWhiteSpace(nombre)) return nombre;

        return user.FindFirst("email")?.Value
               ?? user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
               ?? user.Identity?.Name;
    }

    protected override void OnInitialized()
    {
        SessionTimeout.OnWarning += HandleWarningAsync;
        SessionTimeout.OnExpired += HandleExpiredAsync;

        // El ancho depende de la ruta: sin esto queda el de la pantalla anterior
        // hasta que algo mas provoque un redibujado.
        Navigation.LocationChanged += HandleRutaCambiada;
    }

    private void HandleRutaCambiada(object? _, LocationChangedEventArgs __) => StateHasChanged();

    private async Task HandleWarningAsync()
    {
        await InvokeAsync(() =>
        {
            _showWarning = true;
            _expiresAt = SessionTimeout.ExpiresAt ?? DateTime.UtcNow.AddMinutes(1);
            StateHasChanged();
        });
    }

    private async Task HandleExpiredAsync()
    {
        await InvokeAsync(async () =>
        {
            _showWarning = false;
            Navigation.NavigateTo("/login", replace: true);
            await AuthProvider.LogoutAsync();
        });
    }

    private async Task HandleSessionContinue()
    {
        var ok = await AuthProvider.RefreshSessionAsync();
        if (ok)
            _showWarning = false;
        else
        {
            _showWarning = false;
            Navigation.NavigateTo("/login", replace: true);
            await AuthProvider.LogoutAsync();
        }
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private async Task HandleLogout()
    {
        _showWarning = false;
        Navigation.NavigateTo("/login", replace: true);
        await AuthProvider.LogoutAsync();
    }

    public void Dispose()
    {
        SessionTimeout.OnWarning -= HandleWarningAsync;
        SessionTimeout.OnExpired -= HandleExpiredAsync;
        Navigation.LocationChanged -= HandleRutaCambiada;
    }
}
