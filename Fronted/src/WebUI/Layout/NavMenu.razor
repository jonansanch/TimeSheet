@inject KpgAuthStateProvider AuthProvider
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> L
@implements IDisposable

<MudNavMenu Class="kpg-nav">

    <AuthorizeView>
        <Authorized>
            <div class="kpg-nav-section-label">@L["Nav_SectionMain"]</div>
            <MudNavLink Href="/"
                        Match="NavLinkMatch.All"
                        Icon="@Icons.Material.Filled.Home"
                        >
                @L["Nav_Home"]
            </MudNavLink>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="@($"{Roles.Empleado},{Roles.Supervisor},{Roles.Gerente},{Roles.Admin}")">
        <Authorized>
            <MudNavLink Href="/registro"
                        Icon="@Icons.Material.Filled.EditCalendar"
                        >
                @L["Nav_Register"]
            </MudNavLink>
            <MudNavLink Href="/mis-registros"
                        Icon="@Icons.Material.Filled.History"
                        >
                @L["Nav_MyRecords"]
            </MudNavLink>
            <MudNavLink Href="/mis-solicitudes"
                        Icon="@Icons.Material.Filled.AssignmentLate"
                        >
                @L["Nav_MisSolicitudes"]
            </MudNavLink>
            <MudNavLink Href="/reportar"
                        Icon="@Icons.Material.Filled.Feedback"
                        >
                @L["Nav_Reportar"]
            </MudNavLink>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="@($"{Roles.Supervisor},{Roles.Gerente},{Roles.Admin}")">
        <Authorized>
            <div class="kpg-nav-section-label">@L["Nav_SectionTeam"]</div>
            <MudNavLink Href="/dashboard"
                        Icon="@Icons.Material.Filled.Dashboard"
                        >
                @L["Nav_Dashboard"]
            </MudNavLink>

            <MudNavLink Href="/aprobaciones"
                        Icon="@Icons.Material.Filled.FactCheck"
                        >
                @L["Nav_Aprobaciones"]
            </MudNavLink>

            <MudNavLink Href="/organigrama"
                        Icon="@Icons.Material.Filled.AccountTree"
                        >
                @L["Nav_Organigrama"]
            </MudNavLink>

            <MudNavGroup Title="@L["Nav_Reports"]"
                         Icon="@Icons.Material.Filled.BarChart"
                         Class="@GroupClass(_reportesExpanded, IsReportRoute())"
                         Expanded="_reportesExpanded"
                         ExpandedChanged="SetReportesExpanded">
                <MudNavLink Href="/reportes/horas" Class="kpg-nav-child">
                    @L["Nav_ReporteHoras"]
                </MudNavLink>
                <MudNavLink Href="/reportes/timesheet" Class="kpg-nav-child">
                    @L["Nav_Timesheet"]
                </MudNavLink>
            </MudNavGroup>

            <MudNavLink Href="/notificaciones"
                        Icon="@Icons.Material.Filled.Notifications"
                        >
                @L["Nav_Notifications"]
            </MudNavLink>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="@($"{Roles.Supervisor},{Roles.Gerente}")">
        <Authorized>
            <MudNavLink Href="/bitacora"
                        Icon="@Icons.Material.Filled.ManageSearch"
                        >
                @L["Nav_Bitacora"]
            </MudNavLink>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="@Roles.Admin">
        <Authorized>
            <div class="kpg-nav-section-label">@L["Nav_SectionAdmin"]</div>
            <MudNavGroup Title="@L["Nav_Admin"]"
                         Icon="@Icons.Material.Filled.AdminPanelSettings"
                         Class="@GroupClass(_adminExpanded, IsAdminRoute())"
                         Expanded="_adminExpanded"
                         ExpandedChanged="SetAdminExpanded">
                <MudNavLink Href="/admin/usuarios" Class="kpg-nav-child">
                    @L["Nav_Users"]
                </MudNavLink>
                <MudNavLink Href="/admin/empleados" Class="kpg-nav-child">
                    @L["Nav_Resources"]
                </MudNavLink>
                <MudNavLink Href="/admin/importar-timesheet" Class="kpg-nav-child">
                    @L["Nav_ImportarTimesheet"]
                </MudNavLink>
                <MudNavLink Href="/admin/supervisores-puesto" Class="kpg-nav-child">
                    @L["Nav_SupervisoresPuesto"]
                </MudNavLink>
                <MudNavLink Href="/admin/clientes" Class="kpg-nav-child">
                    @L["Nav_ClientsProjects"]
                </MudNavLink>
                <MudNavLink Href="/solicitudes-excepcion" Class="kpg-nav-child">
                    @L["Nav_ExceptionRequests"]
                </MudNavLink>
                <MudNavLink Href="/admin/bitacora" Class="kpg-nav-child">
                    @L["Nav_AdminBitacora"]
                </MudNavLink>
                <MudNavLink Href="/admin/reportes-usuario" Class="kpg-nav-child">
                    @L["Nav_ReportesAdmin"]
                </MudNavLink>
            </MudNavGroup>

            <MudNavGroup Title="@L["Nav_Params"]"
                         Icon="@Icons.Material.Filled.Settings"
                         Class="@GroupClass(_parametrosExpanded, IsParametersRoute())"
                         Expanded="_parametrosExpanded"
                         ExpandedChanged="SetParametersExpanded">
                <MudNavLink Href="/admin/parametros/configuracion" Class="kpg-nav-child">
                    @L["Nav_GeneralConfig"]
                </MudNavLink>
                <MudNavLink Href="/admin/parametros/modalidades" Class="kpg-nav-child">
                    @L["Nav_Modalities"]
                </MudNavLink>
                <MudNavLink Href="/admin/parametros/lugares" Class="kpg-nav-child">
                    @L["Nav_WorkPlaces"]
                </MudNavLink>
                <MudNavLink Href="/admin/parametros/descripciones" Class="kpg-nav-child">
                    @L["Nav_DescriptionQuality"]
                </MudNavLink>
            </MudNavGroup>
        </Authorized>
    </AuthorizeView>

</MudNavMenu>

@code {
    private bool _reportesExpanded;
    private bool _adminExpanded;
    private bool _parametrosExpanded;

    protected override void OnInitialized()
    {
        SynchronizeGroupsWithRoute();
        Navigation.LocationChanged += HandleLocationChanged;
    }

    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        SynchronizeGroupsWithRoute();
        _ = InvokeAsync(StateHasChanged);
    }

    private void SynchronizeGroupsWithRoute()
    {
        _reportesExpanded = IsReportRoute();
        _parametrosExpanded = IsParametersRoute();
        _adminExpanded = IsAdminRoute();
    }

    private bool IsReportRoute() => IsCurrentRoute("reportes");

    private bool IsParametersRoute() => IsCurrentRoute("admin/parametros");

    private bool IsAdminRoute()
        => (IsCurrentRoute("admin") && !IsParametersRoute())
           || IsCurrentRoute("solicitudes-excepcion");

    private bool IsCurrentRoute(string routePrefix)
    {
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri)
            .Split('?', '#')[0]
            .Trim('/');

        return relativePath.Equals(routePrefix, StringComparison.OrdinalIgnoreCase)
               || relativePath.StartsWith($"{routePrefix}/", StringComparison.OrdinalIgnoreCase);
    }

    private static string GroupClass(bool expanded, bool active)
        => active ? "kpg-nav-group kpg-nav-group-active" : expanded ? "kpg-nav-group kpg-nav-group-expanded" : "kpg-nav-group";

    private void SetReportesExpanded(bool expanded)
        => _reportesExpanded = expanded || IsReportRoute();

    private void SetAdminExpanded(bool expanded)
        => _adminExpanded = expanded || IsAdminRoute();

    private void SetParametersExpanded(bool expanded)
        => _parametrosExpanded = expanded || IsParametersRoute();

    public void Dispose() => Navigation.LocationChanged -= HandleLocationChanged;
}
