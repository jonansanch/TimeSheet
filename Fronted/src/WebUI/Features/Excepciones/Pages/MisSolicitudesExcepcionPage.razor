@page "/mis-solicitudes"
@attribute [Authorize(Roles = $"{Roles.Empleado},{Roles.Supervisor},{Roles.Gerente},{Roles.Admin}")]
@inject ISolicitudExcepcionRepository Repo
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["MisExc_Title"] - KPG Timesheet</PageTitle>

<MudStack Spacing="3" Class="solicitudes-page">
    <KpgPageHeader Title="@L["MisExc_Title"]" Subtitle="@L["MisExc_Subtitle"]">
        <Breadcrumbs>
            <MudBreadcrumbs Items="_breadcrumbs" Separator=">" Class="pa-0" />
        </Breadcrumbs>
    </KpgPageHeader>

    @if (_isLoading)
    {
        <KpgCard Compact="true"><KpgTableSkeleton /></KpgCard>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Dense="true" aria-live="polite">@_errorMessage</MudAlert>
    }
    else if (_solicitudes.Count == 0)
    {
        <KpgCard Compact="true">
            <KpgEmptyState Title="@L["MisExc_NoRequests"]" Icon="@Icons.Material.Outlined.Inbox" />
        </KpgCard>
    }
    else
    {
        <section class="solicitudes-page__table-card" aria-label="@L["MisExc_Title"]">
        <KpgCard Compact="true">
        <div class="solicitudes-page__table-scroll">
        <MudDataGrid T="MiSolicitudExcepcionResponse"
                     Items="_solicitudes"
                     Dense="true"
                     Filterable="false"
                     SortMode="SortMode.Single"
                     RowsPerPage="50">
            <Columns>
                <TemplateColumn Title="@L["Exc_ColDate"]" Sortable="true">
                    <CellTemplate>
                        @context.Item.FechaRegistro.ToString("dd/MM/yyyy")
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.Justificacion" Title="@L["Exc_ColJustification"]" Sortable="false" />
                <TemplateColumn Title="@L["Exc_ColRecord"]" Sortable="false">
                    <CellTemplate>
                        @* Saber si el registro va adjunto evita volver a llenarlo por las dudas. *@
                        @if (context.Item.Registro is { } reg)
                        {
                            <MudTooltip>
                                <ChildContent>
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined"
                                             Icon="@Icons.Material.Filled.AttachFile">
                                        @KpgFormat.Horas(reg.TotalHoras) h
                                    </MudChip>
                                </ChildContent>
                                <TooltipContent>
                                    <div style="text-align:left;max-width:320px;">
                                        <div><b>@reg.Cliente</b> — @reg.Proyecto</div>
                                        <div>@reg.Horario</div>
                                        <div>@reg.Modalidad · @reg.Recurso · @reg.Lugar</div>
                                        <div>@reg.Descripcion</div>
                                    </div>
                                </TooltipContent>
                            </MudTooltip>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">—</MudText>
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@L["Exc_ColStatus"]" Sortable="false">
                    <CellTemplate>
                        <KpgStatusBadge Text="@context.Item.Estado"
                                        Status="@GetEstadoStatus(context.Item.Estado)" />
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@L["Exc_ColAge"]" Sortable="false">
                    <CellTemplate>
                        @{ var dias = (int)(DateTimeOffset.UtcNow - context.Item.Created).TotalDays; }
                        @(string.Format(dias == 1 ? L["Exc_DayAgo"].Value : L["Exc_DaysAgo"].Value, dias))
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent>
                <MudDataGridPager T="MiSolicitudExcepcionResponse" PageSizeOptions="new[] { 10, 20, 50, 100 }" RowsPerPageString="@L["Pager_RowsPerPage"]" InfoFormat="@L["Pager_InfoFormat"]" />
            </PagerContent>
        </MudDataGrid>
        </div>
        </KpgCard>
        </section>
    }
</MudStack>

@code {
    private BreadcrumbItem[] _breadcrumbs => [
        new(L["Nav_Home"].Value, "/"),
        new(L["Nav_MisSolicitudes"].Value, null, disabled: true)
    ];

    private List<MiSolicitudExcepcionResponse> _solicitudes = [];
    private bool _isLoading = true;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _solicitudes = await Repo.GetMisSolicitudesAsync();
        }
        catch
        {
            _errorMessage = L["Exc_ErrorLoad"];
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string GetEstadoStatus(string estado) => estado switch
    {
        "Aprobada" => "success",
        "Rechazada" => "error",
        _ => "warning"
    };
}
