@page "/dashboard"
@attribute [Authorize(Roles = $"{Roles.Supervisor},{Roles.Gerente},{Roles.Admin}")]
@using ApexCharts
@using Color = MudBlazor.Color
@using Size = MudBlazor.Size
@inject IDashboardRepository Repo
@inject CurrentUserService CurrentUser
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Dash_Title"] - KPG Timesheet</PageTitle>

<MudStack Spacing="3" Class="dashboard-page">

    <KpgPageHeader Title="@L["Dash_Title"]" Subtitle="@L["Dash_Subtitle"]">
        <Breadcrumbs><MudBreadcrumbs Items="_breadcrumbs" Separator=">" Class="pa-0" /></Breadcrumbs>
        <Actions>
        <MudDatePicker Label="@L["Dash_DailyStatusDate"]"
                       Date="_fechaDate"
                       DateChanged="OnFechaChangedAsync"
                       MaxDate="DateTime.Today"
                       IsDateDisabledFunc="@(d => d.DayOfWeek == DayOfWeek.Sunday)"
                       PickerVariant="PickerVariant.Dialog"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       HelperText="@L["Dash_DailyStatusDateHelp"]"
                       Style="max-width:220px;" />
        </Actions>
    </KpgPageHeader>

    @if (_isLoadingEstado)
    {
        <MudGrid>
            @for (var i = 0; i < 4; i++)
            {
                <MudItem xs="12" sm="6" md="3">
                    <MudSkeleton Width="100%" Height="90px" SkeletonType="SkeletonType.Rectangle" Style="border-radius:12px;" />
                </MudItem>
            }
        </MudGrid>
        <KpgTableSkeleton Rows="6" />
    }
    else if (!string.IsNullOrWhiteSpace(_errorEstado))
    {
        <MudAlert Severity="Severity.Error" Dense="true" aria-live="polite">@_errorEstado</MudAlert>
    }
    else if (_estado is not null)
    {
        <section class="kpg-kpi-row" aria-label="@L["Dash_Subtitle"]">
            <KpgStatCard Circular="true" Label="@L["Dash_TotalEmployees"]" Value="_estado.TotalEmpleados"
                         Icon="@Icons.Material.Filled.People" Color="Color.Primary" />
            <KpgStatCard Circular="true" Label="@L["Dash_Complete"]" Value="_estado.TotalCompletos"
                         Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" />
            <KpgStatCard Circular="true" Label="@L["Dash_Partial"]" Value="_estado.TotalParciales"
                         Icon="@Icons.Material.Filled.Pending" Color="Color.Warning" />
            <KpgStatCard Circular="true" Label="@L["Dash_Pending"]" Value="_estado.TotalPendientes"
                         Icon="@Icons.Material.Filled.HourglassEmpty" Color="Color.Error" />
        </section>

        <section class="dashboard-workspace" aria-label="@L["Dash_WorkspaceAriaLabel"]">
            <KpgCard Class="dashboard-workspace__team">
                <div class="kpg-card__head">
                    <h2 class="kpg-card__title">@L["Dash_TeamStatusTitle"]</h2>
                    <MudLink Href="/aprobaciones" Typo="Typo.body2">@L["Common_ViewAll"]</MudLink>
                </div>
                @if (_estado.Equipo.Count == 0)
                {
                    <KpgEmptyState Icon="@Icons.Material.Outlined.GroupOff" Title="@L["Dash_NoTeamMembers"]" />
                }
                else
                {
                    <div class="dashboard-team-list" role="list">
                        @foreach (var miembro in _estado.Equipo)
                        {
                            <KpgTeamStatusCard Nombre="@miembro.Nombre" Estado="@miembro.Estado" TotalMinutos="@miembro.TotalMinutos" HorariosRegistrados="@miembro.HorariosRegistrados" />
                        }
                    </div>
                }
            </KpgCard>
            <KpgCard Class="dashboard-workspace__chart">
                <div class="kpg-card__head">
                    <h2 class="kpg-card__title">@L["Dash_HoursDistTitle"]</h2>
                    <MudSelect T="Periodo" Value="_periodo" ValueChanged="CambiarPeriodoAsync"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                               Class="dashboard-period-select" aria-label="@L["Label_Period"]">
                        <MudSelectItem Value="Periodo.Hoy">@L["Status_Today"]</MudSelectItem>
                        <MudSelectItem Value="Periodo.Semana">@L["Status_ThisWeek"]</MudSelectItem>
                        <MudSelectItem Value="Periodo.Mes">@L["Status_ThisMonth"]</MudSelectItem>
                        <MudSelectItem Value="Periodo.Personalizado">@L["Status_Custom"]</MudSelectItem>
                    </MudSelect>
                </div>
                @if (_periodo == Periodo.Personalizado)
                {
                    <MudDateRangePicker DateRange="_rangoPersonalizado"
                                        DateRangeChanged="OnRangoPersonalizadoChangedAsync"
                                        MaxDate="DateTime.Today"
                                        IsDateDisabledFunc="@(d => d.DayOfWeek == DayOfWeek.Sunday)"
                                        PickerVariant="PickerVariant.Dialog"
                                        Variant="Variant.Outlined"
                                        Margin="Margin.Dense"
                                        Class="mb-2"
                                        Style="max-width:280px;" />
                }
                @if (_isLoadingDistribucion) { <MudSkeleton Height="220px" /> }
                else if (!string.IsNullOrWhiteSpace(_errorDistribucion)) { <MudAlert Severity="Severity.Error" Dense="true" aria-live="polite">@_errorDistribucion</MudAlert> }
                else if (_distribucion is null || _distribucion.Consultores.Count == 0) { <KpgEmptyState Icon="@Icons.Material.Outlined.BarChart" Title="@L["Dash_NoHoursInPeriod"]" /> }
                else
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.AccessTime" Color="Color.Primary" Size="Size.Small" />
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @L["Dash_TeamTotal"] <strong>@KpgFormat.Horas(_distribucion.TotalHorasEquipo, 1) h</strong>
                            (@_distribucion.Desde.ToString("dd/MM") – @_distribucion.Hasta.ToString("dd/MM/yyyy"))
                        </MudText>
                    </MudStack>
                    <ApexChart TItem="DistribucionConsultorDto" Options="_chartOptions" Height="@Math.Max(200, _distribucion.Consultores.Count * 48)">
                        <ApexPointSeries TItem="DistribucionConsultorDto" Items="_distribucion.Consultores" Name="@L["Label_Hours"]" XValue="@(e => e.Nombre)" YValue="@(e => e.TotalHoras)" SeriesType="SeriesType.Bar" />
                    </ApexChart>
                }
            </KpgCard>
            <KpgCard Class="dashboard-workspace__critical">
                <div class="kpg-card__head">
                    <h2 class="kpg-card__title">
                        @L["Dash_CriticalPending"]
                        @if (_criticos is { Pendientes.Count: > 0 })
                        {
                            <span class="dashboard-count-badge">@_criticos.Pendientes.Count</span>
                        }
                    </h2>
                    @if (_criticos is { Pendientes.Count: > 6 })
                    {
                        <MudLink Href="/aprobaciones" Typo="Typo.body2">@string.Format(L["Dash_SeeAllCritical"], _criticos.Pendientes.Count)</MudLink>
                    }
                </div>
                @if (_isLoadingCriticos) { <MudSkeleton Height="180px" /> }
                else if (_criticos is null || _criticos.Pendientes.Count == 0) { <KpgEmptyState Icon="@Icons.Material.Outlined.DoneAll" Title="@L["Apr_NothingPending"]" /> }
                else
                {
                    <ul class="dashboard-critical-list">
                        @foreach (var p in _criticos.Pendientes.Take(6))
                        {
                            <li class="dashboard-critical-row">
                                <span class="dashboard-critical-row__avatar" aria-hidden="true">@Iniciales(p.Nombre)</span>
                                <div class="dashboard-critical-row__body">
                                    <span class="dashboard-critical-row__name">@p.Nombre</span>
                                    <span class="dashboard-critical-row__meta">@(p.DiasSinRegistro >= 999 ? L["Dash_NoDaysWithout"].Value : string.Format(L["Dash_DaysWithout"], p.DiasSinRegistro))</span>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </KpgCard>
        </section>

    }

    <MudDivider />

    <AuthorizeView Roles="@($"{Roles.Gerente},{Roles.Admin}")">
        <Authorized>
            <MudDivider />
            <MudStack Spacing="2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudIcon Icon="@Icons.Material.Filled.Insights" Color="Color.Primary" />
                        <MudText Typo="Typo.h6" Style="font-weight:600;">@L["Dash_GerencialSubtitle"]</MudText>
                    </MudStack>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @L["Label_Period"]: @_distribucion?.Desde.ToString("dd/MM") – @_distribucion?.Hasta.ToString("dd/MM/yyyy")
                    </MudText>
                </MudStack>

                @if (_isLoadingGerencial)
                {
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudSkeleton Width="100%" Height="300px" SkeletonType="SkeletonType.Rectangle" Style="border-radius:12px;" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudSkeleton Width="100%" Height="300px" SkeletonType="SkeletonType.Rectangle" Style="border-radius:12px;" />
                        </MudItem>
                    </MudGrid>
                }
                else if (!string.IsNullOrWhiteSpace(_errorGerencial))
                {
                    <MudAlert Severity="Severity.Error" Dense="true" aria-live="polite">@_errorGerencial</MudAlert>
                }
                else if (_gerencial is not null)
                {
                    <MudGrid>
                        <MudItem xs="12" sm="6" md="3">
                            <KpgCard Compact="true">
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Dash_TotalHours"]</MudText>
                                    <MudText Typo="Typo.h4" Style="font-weight:700;">@KpgFormat.Horas(_gerencial.TotalHoras, 1) h</MudText>
                                </MudStack>
                            </KpgCard>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <KpgCard Compact="true">
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Dash_ActiveClients"]</MudText>
                                    <MudText Typo="Typo.h4" Style="font-weight:700;">@_gerencial.TotalClientes</MudText>
                                </MudStack>
                            </KpgCard>
                        </MudItem>
                        @if (_gerencial.PorCliente.Count > 0)
                        {
                            <MudItem xs="12" sm="12" md="6">
                                <KpgCard Compact="true">
                                    <MudStack Spacing="1">
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Dash_TopClient"]</MudText>
                                        <MudText Typo="Typo.h6" Style="font-weight:600;">@_gerencial.PorCliente[0].Cliente</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@KpgFormat.Horas(_gerencial.PorCliente[0].TotalHoras, 1) h</MudText>
                                    </MudStack>
                                </KpgCard>
                            </MudItem>
                        }
                    </MudGrid>

                    @if (_gerencial.PorCliente.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info">@L["Dash_NoHoursInPeriod"]</MudAlert>
                    }
                    else
                    {
                        <MudGrid>
                            <MudItem xs="12" md="5">
                                <KpgCard Compact="true">
                                    <MudText Typo="Typo.subtitle2" Class="mb-2" Style="font-weight:600;">@L["Dash_ByClient"]</MudText>
                                    <ApexChart TItem="HorasPorClienteDto"
                                               Options="_donutOptions"
                                               Height="280">
                                        <ApexPointSeries TItem="HorasPorClienteDto"
                                                         Items="_gerencial.PorCliente"
                                                         Name="@L["Label_Hours"]"
                                                         XValue="@(e => e.Cliente)"
                                                         YValue="@(e => e.TotalHoras)"
                                                         SeriesType="SeriesType.Donut" />
                                    </ApexChart>
                                </KpgCard>
                            </MudItem>
                            <MudItem xs="12" md="7">
                                <KpgCard Compact="true">
                                    <MudText Typo="Typo.subtitle2" Class="mb-2" Style="font-weight:600;">@L["Dash_ByProject"]</MudText>
                                    <ApexChart TItem="HorasPorProyectoDto"
                                               Options="_barProyectoOptions"
                                               Height="@Math.Max(200, _gerencial.PorProyecto.Count * 40)">
                                        <ApexPointSeries TItem="HorasPorProyectoDto"
                                                         Items="_gerencial.PorProyecto"
                                                         Name="@L["Label_Hours"]"
                                                         XValue="@(e => e.Proyecto)"
                                                         YValue="@(e => e.TotalHoras)"
                                                         SeriesType="SeriesType.Bar" />
                                    </ApexChart>
                                </KpgCard>
                            </MudItem>
                        </MudGrid>
                    }
                }
            </MudStack>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="@Roles.Admin">
        <Authorized>
            <MudDivider />
            <MudStack Spacing="2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Color="Color.Primary" />
                    <MudText Typo="Typo.h6" Style="font-weight:600;">@L["Dash_AdminMetrics"]</MudText>
                </MudStack>

                @if (_isLoadingAdmin)
                {
                    <MudGrid>
                        @for (var i = 0; i < 4; i++)
                        {
                            <MudItem xs="12" sm="6" md="3">
                                <MudSkeleton Width="100%" Height="90px" SkeletonType="SkeletonType.Rectangle" Style="border-radius:12px;" />
                            </MudItem>
                        }
                    </MudGrid>
                    <MudSkeleton Width="100%" Height="260px" SkeletonType="SkeletonType.Rectangle" Style="border-radius:12px;" />
                }
                else if (!string.IsNullOrWhiteSpace(_errorAdmin))
                {
                    <MudAlert Severity="Severity.Error" Dense="true" aria-live="polite">@_errorAdmin</MudAlert>
                }
                else if (_metricas is not null)
                {
                    <MudGrid>
                        <MudItem xs="12" sm="6" md="3">
                            <KpgStatCard Label="@L["Dash_TotalRecords"]"
                                         Value="_metricas.TotalRegistros"
                                         Icon="@Icons.Material.Filled.Assignment"
                                         Color="Color.Primary" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <KpgCard Compact="true">
                                <MudStack Spacing="1">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <MudIcon Icon="@Icons.Material.Filled.AccessTime" Color="Color.Success" Size="Size.Medium" />
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Dash_TotalHours"]</MudText>
                                    </MudStack>
                                    <MudText Typo="Typo.h4" Style="font-weight:700;">@KpgFormat.Horas(_metricas.TotalHoras, 1) h</MudText>
                                </MudStack>
                            </KpgCard>
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <KpgStatCard Label="@L["Dash_ActiveUsers"]"
                                         Value="_metricas.UsuariosActivos"
                                         Icon="@Icons.Material.Filled.People"
                                         Color="Color.Info" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <KpgStatCard Label="@L["Dash_PendingToday"]"
                                         Value="_metricas.PendientesHoy"
                                         Icon="@Icons.Material.Filled.Warning"
                                         Color="@(_metricas.PendientesHoy > 0 ? Color.Warning : Color.Success)" />
                        </MudItem>
                    </MudGrid>

                    @if (_metricas.Tendencia.Count > 0)
                    {
                        <KpgCard Compact="true">
                            <MudText Typo="Typo.subtitle2" Class="mb-2" Style="font-weight:600;">
                                @L["Dash_Tendency"] (@_metricas.Desde.ToString("dd/MM") – @_metricas.Hasta.ToString("dd/MM/yyyy"))
                            </MudText>
                            <ApexChart TItem="TendenciaDiaDto"
                                       Options="_lineOptions"
                                       Height="240">
                                <ApexPointSeries TItem="TendenciaDiaDto"
                                                 Items="_metricas.Tendencia"
                                                 Name="Registros"
                                                 XValue="@(e => e.Fecha.ToString("dd/MM"))"
                                                 YValue="@(e => (decimal)e.TotalRegistros)"
                                                 SeriesType="SeriesType.Line" />
                                <ApexPointSeries TItem="TendenciaDiaDto"
                                                 Items="_metricas.Tendencia"
                                                 Name="@L["Label_Hours"]"
                                                 XValue="@(e => e.Fecha.ToString("dd/MM"))"
                                                 YValue="@(e => e.TotalHoras)"
                                                 SeriesType="SeriesType.Line" />
                            </ApexChart>
                        </KpgCard>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info">@L["Dash_NoHoursInPeriod"]</MudAlert>
                    }
                }
            </MudStack>
        </Authorized>
    </AuthorizeView>

</MudStack>

@code {
    private BreadcrumbItem[] _breadcrumbs => [
        new(L["Nav_Home"].Value, "/"),
        new(L["Nav_Dashboard"].Value, null, disabled: true)
    ];

    private static string Iniciales(string nombre) =>
        string.Join("", nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));

    // ── Estado diario ────────────────────────────────────────────────
    private EstadoEquipoResponse? _estado;
    private bool _isLoadingEstado = true;
    private string _errorEstado = string.Empty;
    private DateOnly _fecha = DateOnly.FromDateTime(DateTime.Today);
    private DateTime? _fechaDate => _fecha.ToDateTime(TimeOnly.MinValue);

    // ── Pendientes críticos ──────────────────────────────────────────
    private PendientesCriticosResponse? _criticos;
    private bool _isLoadingCriticos = true;
    private string _errorCriticos = string.Empty;

    // ── Distribución de horas ────────────────────────────────────────
    private DistribucionHorasResponse? _distribucion;
    // ── Dashboard gerencial ──────────────────────────────────────────
    private DashboardGerencialResponse? _gerencial;
    private bool _isLoadingGerencial = true;
    private string _errorGerencial = string.Empty;
    private bool _puedeVerGerencial;
    // ── Métricas globales (Admin) ────────────────────────────────────
    private MetricasGlobalesResponse? _metricas;
    private bool _isLoadingAdmin = true;
    private string _errorAdmin = string.Empty;
    private bool _puedeVerAdmin;
    private bool _isLoadingDistribucion = true;
    private string _errorDistribucion = string.Empty;
    private Periodo _periodo = Periodo.Semana;
    private DateRange _rangoPersonalizado = new(DateTime.Today.AddDays(-6), DateTime.Today);

    /// <summary>ApexCharts no lee variables CSS: se fija al mismo valor que --kpg-border-default.</summary>
    private const string ChartGridBorderColor = "#E5EAF0";

    /// <summary>Paleta KPG para series: navy primero, luego secundario y semánticos sobrios.</summary>
    private static readonly string[] ChartPalette = ["#0B466A", "#087EA4", "#3B82F6", "#15803D", "#F59E0B", "#64748B"];

    private ApexChartOptions<DistribucionConsultorDto> _chartOptions = new()
    {
        Colors = [.. ChartPalette],
        PlotOptions = new PlotOptions
        {
            Bar = new PlotOptionsBar { Horizontal = true, BorderRadius = 4 }
        },
        Xaxis = new XAxis { Title = new AxisTitle { Text = "Horas" } },
        DataLabels = new DataLabels { Enabled = true },
        Legend = new Legend { Show = false },
        Grid = new Grid { BorderColor = ChartGridBorderColor }
    };

    private ApexChartOptions<TendenciaDiaDto> _lineOptions = new()
    {
        Colors = [.. ChartPalette],
        Stroke = new Stroke { Curve = Curve.Smooth, Width = [2, 2] },
        DataLabels = new DataLabels { Enabled = false },
        Legend = new Legend { Position = LegendPosition.Top },
        Grid = new Grid { BorderColor = ChartGridBorderColor }
    };

    private ApexChartOptions<HorasPorClienteDto> _donutOptions = new()
    {
        Colors = [.. ChartPalette],
        DataLabels = new DataLabels { Enabled = true },
        Legend = new Legend { Position = LegendPosition.Bottom }
    };

    private ApexChartOptions<HorasPorProyectoDto> _barProyectoOptions = new()
    {
        Colors = [.. ChartPalette],
        PlotOptions = new PlotOptions
        {
            Bar = new PlotOptionsBar { Horizontal = true, BorderRadius = 4 }
        },
        DataLabels = new DataLabels { Enabled = true },
        Legend = new Legend { Show = false },
        Grid = new Grid { BorderColor = ChartGridBorderColor }
    };

    protected override async Task OnInitializedAsync()
    {
        await CargarPermisosAsync();

        var cargas = new List<Task>
        {
            CargarEstadoAsync(),
            CargarCriticosAsync(),
            CargarDistribucionAsync()
        };

        if (_puedeVerGerencial)
            cargas.Add(CargarGerencialAsync());
        else
            _isLoadingGerencial = false;

        if (_puedeVerAdmin)
            cargas.Add(CargarAdminAsync());
        else
            _isLoadingAdmin = false;

        await Task.WhenAll(cargas);
    }

    private async Task OnFechaChangedAsync(DateTime? date)
    {
        if (date is null) return;
        _fecha = DateOnly.FromDateTime(date.Value);
        var carga = CargarEstadoAsync();
        StateHasChanged();
        await carga;
    }

    private async Task CambiarPeriodoAsync(Periodo periodo)
    {
        _periodo = periodo;
        await CargarDatosPeriodoAsync();
    }

    private async Task OnRangoPersonalizadoChangedAsync(DateRange rango)
    {
        _rangoPersonalizado = rango;
        if (rango.Start.HasValue && rango.End.HasValue)
            await CargarDatosPeriodoAsync();
    }

    private async Task CargarPermisosAsync()
    {
        var roles = await CurrentUser.GetRolesAsync();
        _puedeVerAdmin = roles.Contains(Roles.Admin);
        _puedeVerGerencial = _puedeVerAdmin || roles.Contains(Roles.Gerente);
    }

    private async Task CargarDatosPeriodoAsync()
    {
        var cargas = new List<Task> { CargarDistribucionAsync() };

        if (_puedeVerGerencial)
            cargas.Add(CargarGerencialAsync());

        if (_puedeVerAdmin)
            cargas.Add(CargarAdminAsync());

        StateHasChanged();
        await Task.WhenAll(cargas);
    }

    private async Task CargarCriticosAsync()
    {
        _isLoadingCriticos = true;
        _errorCriticos = string.Empty;
        try
        {
            _criticos = await Repo.GetPendientesCriticosAsync();
            if (_criticos is null) _errorCriticos = L["Dash_ErrorLoad"];
        }
        catch { _errorCriticos = L["Error_Server"]; }
        finally { _isLoadingCriticos = false; }
    }

    private async Task CargarEstadoAsync()
    {
        _isLoadingEstado = true;
        _errorEstado = string.Empty;
        try
        {
            _estado = await Repo.GetEstadoEquipoAsync(_fecha);
            if (_estado is null) _errorEstado = L["Dash_ErrorLoad"];
        }
        catch { _errorEstado = L["Error_Server"]; }
        finally { _isLoadingEstado = false; }
    }

    private async Task CargarDistribucionAsync()
    {
        _isLoadingDistribucion = true;
        _errorDistribucion = string.Empty;
        try
        {
            var (desde, hasta) = ObtenerRango();
            _distribucion = await Repo.GetDistribucionHorasAsync(desde, hasta);
            if (_distribucion is null) _errorDistribucion = L["Dash_ErrorLoad"];
        }
        catch { _errorDistribucion = L["Error_Server"]; }
        finally { _isLoadingDistribucion = false; }
    }

    private (DateOnly desde, DateOnly hasta) ObtenerRango()
    {
        var hoy = DateOnly.FromDateTime(DateTime.Today);
        return _periodo switch
        {
            Periodo.Hoy          => (hoy, hoy),
            Periodo.Semana       => (InicioSemana(hoy), hoy),
            Periodo.Mes          => (new DateOnly(hoy.Year, hoy.Month, 1), hoy),
            Periodo.Personalizado => (
                _rangoPersonalizado.Start.HasValue ? DateOnly.FromDateTime(_rangoPersonalizado.Start.Value) : hoy.AddDays(-6),
                _rangoPersonalizado.End.HasValue   ? DateOnly.FromDateTime(_rangoPersonalizado.End.Value)   : hoy),
            _ => (hoy, hoy)
        };
    }

    private async Task CargarGerencialAsync()
    {
        _isLoadingGerencial = true;
        _errorGerencial = string.Empty;
        try
        {
            var (desde, hasta) = ObtenerRango();
            _gerencial = await Repo.GetDashboardGerencialAsync(desde, hasta);
            if (_gerencial is null) _errorGerencial = L["Dash_ErrorLoad"];
        }
        catch { _errorGerencial = L["Error_Server"]; }
        finally { _isLoadingGerencial = false; }
    }

    private async Task CargarAdminAsync()
    {
        _isLoadingAdmin = true;
        _errorAdmin = string.Empty;
        try
        {
            var (desde, hasta) = ObtenerRango();
            _metricas = await Repo.GetMetricasGlobalesAsync(desde, hasta);
            if (_metricas is null) _errorAdmin = L["Dash_ErrorLoad"];
        }
        catch { _errorAdmin = L["Error_Server"]; }
        finally { _isLoadingAdmin = false; }
    }

    private static DateOnly InicioSemana(DateOnly fecha)
    {
        var diff = (int)fecha.DayOfWeek - (int)DayOfWeek.Monday;
        if (diff < 0) diff += 7;
        return fecha.AddDays(-diff);
    }

    private enum Periodo { Hoy, Semana, Mes, Personalizado }
}
