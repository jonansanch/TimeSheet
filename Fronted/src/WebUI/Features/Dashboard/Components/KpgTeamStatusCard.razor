@using KPG.Timesheet.WebUI.Infrastructure.Repositories.Models

<div class="team-status-row" role="listitem">
    <span class="kpg-avatar team-status-row__avatar" aria-hidden="true">@Iniciales</span>
    <div class="team-status-row__identity">
        <span class="team-status-row__name">@Nombre</span>
        <span class="team-status-row__meta">@HorariosRegistrados horarios</span>
    </div>
    <span class="team-status-row__hours">@HorasFormateadas h</span>
    <span class="@($"team-status-row__state team-status-row__state--{EstadoTono}")">@Estado</span>
</div>

<style>
    .team-status-row { display:grid; grid-template-columns:32px minmax(0,1fr) auto 92px; align-items:center; gap:var(--kpg-space-3); min-height:52px; padding:var(--kpg-space-2) 0; border-bottom:1px solid var(--kpg-border-default); }
    .team-status-row:last-child { border-bottom:0; }
    .team-status-row__identity { display:flex; min-width:0; flex-direction:column; line-height:1.3; }
    .team-status-row__name { overflow:hidden; font-size:var(--kpg-font-size-sm); font-weight:600; text-overflow:ellipsis; white-space:nowrap; }
    .team-status-row__meta { color:var(--kpg-text-secondary); font-size:var(--kpg-font-size-xs); }
    .team-status-row__hours { font-size:var(--kpg-font-size-sm); font-weight:600; font-variant-numeric:tabular-nums; white-space:nowrap; }
    .team-status-row__state { justify-self:end; padding:2px var(--kpg-space-2); border:1px solid currentColor; border-radius:var(--kpg-radius-pill); font-size:var(--kpg-font-size-xs); font-weight:600; white-space:nowrap; }
    .team-status-row__state--success { color:var(--kpg-status-success); background:var(--kpg-status-success-bg); }
    .team-status-row__state--warning { color:var(--kpg-status-warning); background:var(--kpg-status-warning-bg); }
    .team-status-row__state--error { color:var(--kpg-status-error); background:var(--kpg-status-error-bg); }
    @@media (max-width:599.98px) { .team-status-row { grid-template-columns:32px minmax(0,1fr) auto; } .team-status-row__hours { display:none; } }
</style>

@code {
    [Parameter, EditorRequired] public string Nombre { get; set; } = default!;
    [Parameter, EditorRequired] public string Estado { get; set; } = default!;
    [Parameter] public int TotalMinutos { get; set; }
    [Parameter] public int HorariosRegistrados { get; set; }

    private string HorasFormateadas => $"{TotalMinutos / 60}:{TotalMinutos % 60:00}";

    private string Iniciales => string.Join("", Nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));

    /// <summary>Un día sin registrar es lo que requiere acción del supervisor: va en rojo.</summary>
    private string EstadoTono => Estado switch
    {
        "Completo" => "success",
        "Parcial"  => "warning",
        _          => "error"
    };
}
