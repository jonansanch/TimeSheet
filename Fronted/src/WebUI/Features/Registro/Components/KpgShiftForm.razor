@inject IRegistroHorasRepository RegistroHorasRepository
@inject IParametroSistemaRepository ParametroSistemaRepository
@inject IDialogService DialogService
@inject ISolicitudExcepcionRepository SolicitudExcepcionRepository
@inject IClienteRepository ClienteRepository
@inject CatalogosCacheService CatalogosCache
@inject IStringLocalizer<SharedResource> L
@inject VoiceInputService VoiceInput
@inject VoiceParser VoiceParser
@inject IVozRepository VozRepository
@inject AuthenticationStateProvider AuthState
@implements IAsyncDisposable

<div class="kpg-shift-form">
    <div class="kpg-shift-form__top">
        <div class="kpg-shift-form__header">@Header</div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Dense="true" aria-live="polite">@_errorMessage</MudAlert>
    }

    @if (_guardado)
    {
        <MudAlert Severity="Severity.Success" role="status" Dense="true" Icon="@Icons.Material.Filled.EventAvailable">
            <b>@L["Reg_SavedTitle"]</b> — @_fecha?.ToString("dd/MM/yyyy") · @L["Reg_TotalHours"] @TotalHorasFormateado @L["Reg_TotalHoursSuffix"]
        </MudAlert>
    }

    @if (EsFueraDeVentana)
    {
        @* El registro ya no se bloquea: se llena completo y viaja con la justificacion. *@
        <MudAlert Severity="Severity.Warning" Dense="true">
            @string.Format(L["Reg_ExceptionWarning"], _windowDays) @L["Reg_ExceptionFillForm"]
        </MudAlert>
    }

    @if (_excepcionEnviada)
    {
        <MudAlert Severity="Severity.Success" Dense="true">
            @L["Reg_ExceptionSent"] @_excepcionFecha.ToString("dd/MM/yyyy").
        </MudAlert>
    }

    @if (_voiceCamposNoDetectados.Count > 0)
    {
        <MudAlert Severity="Severity.Warning" Dense="true"
                  ShowCloseIcon="true"
                  CloseIconClicked="@(() => _voiceCamposNoDetectados = [])">
            Completar manualmente: @string.Join(", ", _voiceCamposNoDetectados)
        </MudAlert>
    }

    @* Lo ya registrado de ese dia y proyecto: sin esto el usuario reescribia el
       Horario 1 sin saber que estaba ocupado y solo veia un error generico. *@
    @if (_registroExistente is not null)
    {
        <MudAlert Severity="@(TodosLosHorariosOcupados ? Severity.Warning : Severity.Info)" Dense="true">
            @(TodosLosHorariosOcupados ? L["Reg_DayFull"] : L["Reg_DayHasRecord"])
        </MudAlert>
    }

    <MudForm @ref="_form" @bind-IsValid="_formIsValid" Class="kpg-shift-form__form">
        <div class="kpg-shift-form__grid">
            @* ── Tramos de horario ─────────────────────────── *@
            <KpgCard Class="kpg-shift-form__schedules">
                <div class="kpg-card__head">
                    <h2 class="kpg-card__title">@L["Reg_Schedules"]</h2>
                    @if (_browserSupportsVoice)
                    {
                        @if (_voiceState == VoiceState.Processing)
                        {
                            <span class="kpg-shift-form__voice-status">
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
                                <MudText Typo="Typo.caption">Procesando...</MudText>
                            </span>
                        }
                        else
                        {
                            <MudTooltip Text="@(_voiceState == VoiceState.Listening ? "Detener dictado" : "Dictar registro")">
                                <MudIconButton Icon="@(_voiceState == VoiceState.Listening ? Icons.Material.Filled.MicOff : Icons.Material.Outlined.Mic)"
                                               Color="@(_voiceState == VoiceState.Listening ? Color.Error : Color.Default)"
                                               Size="Size.Small"
                                               Class="@(_voiceState == VoiceState.Listening ? "kpg-voice-pulse" : "")"
                                               OnClick="ToggleVoiceAsync"
                                               aria-label="@(_voiceState == VoiceState.Listening ? "Detener dictado" : "Dictar registro")" />
                            </MudTooltip>
                        }
                    }
                </div>

                <section class="shift-table" aria-label="@L["Reg_Schedules"]">
                    <div class="shift-table__head" aria-hidden="true">
                        <span>@L["Label_Entry"]</span><span>@L["Label_Exit"]</span><span>@L["Label_Duration"]</span><span></span>
                    </div>
                    @for (var i = 1; i <= TramosVisibles; i++)
                    {
                        var numero = i;
                        var ocupado = BloqueOcupado(numero);
                        <div class="@($"shift-table__row{(ocupado ? " shift-table__row--saved" : "")}")">
                            <MudTextField T="string"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          InputType="InputType.Time"
                                          step="@CuartoHoraStep"
                                          Disabled="@ocupado"
                                          Value="@(ocupado ? TsToStr(EntradaGuardada(numero)) : TsToStr(_model.GetEntrada(numero)))"
                                          ValueChanged="@(v => _model.SetEntrada(numero, ParseTs(v)))"
                                          Error="@(!ocupado && NoEsCuartoDeHora(_model.GetEntrada(numero)))"
                                          ErrorText="@L["Reg_QuarterHourOnly"]"
                                          aria-label="@($"{L["Label_Entry"].Value} {L[$"Reg_Shift{numero}"].Value}")" />
                            <MudTextField T="string"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          InputType="InputType.Time"
                                          step="@CuartoHoraStep"
                                          Disabled="@ocupado"
                                          Value="@(ocupado ? TsToStr(SalidaGuardada(numero)) : TsToStr(_model.GetSalida(numero)))"
                                          ValueChanged="@(v => _model.SetSalida(numero, ParseTs(v)))"
                                          Error="@(!ocupado && (IsInvalidBloque(numero) || NoEsCuartoDeHora(_model.GetSalida(numero))))"
                                          ErrorText="@(IsInvalidBloque(numero) ? L["Reg_ExitAfterEntry"] : L["Reg_QuarterHourOnly"])"
                                          aria-label="@($"{L["Label_Exit"].Value} {L[$"Reg_Shift{numero}"].Value}")" />
                            <output class="shift-table__duration">@(ocupado ? DuracionGuardada(numero) : DuracionBloque(numero))</output>
                            @if (ocupado)
                            {
                                <MudTooltip Text="@L["Reg_ShiftAlreadySaved"]">
                                    <MudIcon Icon="@Icons.Material.Outlined.Lock" Size="Size.Small" Color="Color.Success"
                                             aria-label="@($"{L[$"Reg_Shift{numero}"].Value}: {L["Reg_ShiftAlreadySaved"].Value}")" />
                                </MudTooltip>
                            }
                            else
                            {
                                <MudIconButton Icon="@Icons.Material.Outlined.Delete"
                                               Color="Color.Error" Size="Size.Small"
                                               aria-label="@($"{L["Btn_Delete"].Value} {L[$"Reg_Shift{numero}"].Value}")"
                                               OnClick="@(() => QuitarTramo(numero))" />
                            }
                        </div>
                    }
                    <div class="shift-table__foot">
                        @if (TramosVisibles < TotalHorarios)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="AgregarTramo">
                                @L["Reg_AddShift"]
                            </MudButton>
                        }
                        <span class="shift-table__total">@L["Reg_DayTotal"] <strong>@TotalFormulario</strong></span>
                    </div>
                </section>
                @if (_sinTurno)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3">
                        @L["Reg_AtLeastOneShift"]
                    </MudAlert>
                }
            </KpgCard>

            @* ── Usados recientemente ──────────────────────── *@
            <KpgCard Class="kpg-shift-form__recent">
                <h2 class="kpg-card__title">@L["Reg_RecentTitle"]</h2>
                <KpgRecentSuggestions OnSuggestionSelected="HandleSuggestionSelected" />
            </KpgCard>
        </div>

        @* ── Información del registro ─────────────────────── *@
        <KpgCard Class="kpg-shift-form__daydata">
            <h2 class="kpg-card__title">@L["Reg_DayData"]</h2>
            <div class="kpg-shift-form__fields">
                <div class="kpg-shift-form__client">
                    <MudSelect T="int?"
                               Label="@L["Label_Client"]"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Value="@_model.ClienteId"
                               ValueChanged="HandleClienteChanged"
                               Required="true"
                               RequiredError="@L["Reg_ClientRequired"]"
                               aria-label="@L["Label_Client"]">
                        @foreach (var c in _catalogoClientes)
                        {
                            <MudSelectItem T="int?" Value="@c.Id">@c.Nombre</MudSelectItem>
                        }
                    </MudSelect>
                </div>
                @* Sin cliente elegido no se ofrece ningun proyecto: antes se listaban
                   los de todos los clientes y se podia armar una pareja invalida. *@
                <div class="kpg-shift-form__project">
                    <MudSelect T="int?"
                               Label="@L["Label_Project"]"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Value="@_model.ProyectoId"
                               ValueChanged="HandleProyectoChanged"
                               Disabled="@(_model.ClienteId is null)"
                               Required="true"
                               RequiredError="@L["Reg_ProjectRequired"]"
                               HelperText="@(_model.ClienteId is null ? L["Reg_SelectClientFirst"].Value : null)"
                               aria-label="@L["Label_Project"]">
                        @foreach (var p in ProyectosDelCliente)
                        {
                            <MudSelectItem T="int?" Value="@p.Id">@p.Nombre</MudSelectItem>
                        }
                    </MudSelect>
                </div>
                <div class="kpg-shift-form__resource">
                    <MudSelect T="string" Label="@L["Label_Resource"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                               @bind-Value="_model.Recurso" Required="true" RequiredError="@L["Reg_ResourceRequired"]"
                               HelperText="@(_puestoDelUsuario is null ? null : L["Reg_ResourceFromPuesto"].Value)">
                        @foreach (var r in _recursos)
                        {
                            <MudSelectItem Value="@r">@r</MudSelectItem>
                        }
                    </MudSelect>
                </div>
                <div class="kpg-shift-form__modality">
                    <span id="modalidad-label" class="kpg-shift-form__modality-label">@L["Label_Modality"] *</span>
                    <div role="radiogroup" aria-labelledby="modalidad-label" class="kpg-segmented">
                        @foreach (var m in _modalidades)
                        {
                            var isSelected = _model.Modalidad == m;
                            var isFirst = _modalidades.Count > 0 && m == _modalidades[0];
                            var tabIdx = isSelected || (string.IsNullOrWhiteSpace(_model.Modalidad) && isFirst) ? 0 : -1;
                            <button type="button"
                                    class="@($"kpg-segmented__option{(isSelected ? " kpg-segmented__option--selected" : "")}")"
                                    role="radio"
                                    aria-checked="@(isSelected ? "true" : "false")"
                                    tabindex="@tabIdx"
                                    @onkeydown="@(e => HandleModalidadKey(e))"
                                    @onclick="@(() => { _model.Modalidad = m; _touchedModalidad = true; })">
                                @m
                            </button>
                        }
                    </div>
                    @if (string.IsNullOrWhiteSpace(_model.Modalidad) && _touchedModalidad)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Error">@L["Reg_ModalityRequired"]</MudText>
                    }
                </div>
                <div class="kpg-shift-form__place">
                    <MudSelect T="string" Label="@L["Label_Place"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                               @bind-Value="_model.Lugar" Required="true" RequiredError="@L["Reg_PlaceRequired"]">
                        @foreach (var l in _lugares)
                        {
                            <MudSelectItem Value="@l">@l</MudSelectItem>
                        }
                    </MudSelect>
                </div>
                <div class="kpg-shift-form__description">
                    <MudTextField T="string"
                                  Label="@L["Label_Description"]"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Lines="3"
                                  @bind-Value="_model.Descripcion"
                                  Immediate="true"
                                  MaxLength="@MaxDescripcion"
                                  Required="true" RequiredError="@L["Reg_DescriptionRequired"]"
                                  Counter="@MaxDescripcion"
                                  Error="@DescripcionExcedida"
                                  ErrorText="@string.Format(L["Reg_DescriptionTooLong"], MaxDescripcion)"
                                  Class="@(DescripcionExcedida ? "kpg-field-error" : null)" />
                </div>
            </div>

            <div class="kpg-shift-form__actions">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           Disabled="@_isSaving"
                           OnClick="CancelarAsync">
                    @L["Btn_Cancel"]
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="@(EsFueraDeVentana ? Color.Warning : Color.Primary)"
                           StartIcon="@(_isSaving ? null : Icons.Material.Outlined.Save)"
                           Disabled="@_isSaving"
                           OnClick="SaveAsync">
                    @if (_isSaving)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <span>@L["Reg_Saving"]</span>
                    }
                    else
                    {
                        <span>@TextoBotonGuardar</span>
                    }
                </MudButton>
            </div>
        </KpgCard>
    </MudForm>
</div>


@code {
    [Parameter] public EventCallback<DateOnly> OnGuardado { get; set; }

    /// <summary>Encabezado de la pagina; comparte fila con el selector de fecha.</summary>
    [Parameter] public RenderFragment? Header { get; set; }

    /// <summary>Bloques horarios que admite un registro diario (ver RegistroHoras.TotalBloques).</summary>
    private const int TotalHorarios = 3;

    private MudForm _form = default!;

    private DateTime? _fecha = DateTime.Today;
    private bool _formIsValid;
    private bool _isSaving;
    private bool _guardado;
    private bool _sinTurno;
    private bool _touchedModalidad;
    private string? _errorMessage;
    private int _windowDays = 3;
    private DateAvailability _dateAvailability = DateAvailability.Available;
    private bool _excepcionEnviada;
    private DateOnly _excepcionFecha;

    private RegistroHorasResponse? _response;

    private readonly DayFormModel _model = new();

    // Solo se usa si el catalogo no responde; debe reflejar las modalidades vigentes.
    private static readonly string[] ModalidadesFallback = ["Cliente", "Remoto"];
    private static readonly string[] RecursosFallback  = ["Consultor", "Analista", "Líder técnico"];
    private static readonly string[] LugaresFallback   = ["Presencial Oficina", "Presencial Viaje", "Presencial Cliente", "Remoto"];

    private List<ClienteConProyectosResponse> _catalogoClientes = [];
    private List<RegistroRecienteResponse> _sugerenciasRecientes = [];
    private List<string> _modalidades = [.. ModalidadesFallback];
    private List<string> _recursos    = [];
    private List<string> _lugares     = [.. LugaresFallback];

    private string TotalHorasFormateado
    {
        get
        {
            if (_response is null) return string.Empty;
            var totalMin = Minutos(_response.HoraEntrada1, _response.HoraSalida1)
                         + Minutos(_response.HoraEntrada2, _response.HoraSalida2)
                         + Minutos(_response.HoraEntrada3, _response.HoraSalida3);
            return $"{totalMin / 60:D2}:{totalMin % 60:D2}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try { _sugerenciasRecientes = await RegistroHorasRepository.GetRecientesAsync(5); } catch { }
        try { _windowDays = await ParametroSistemaRepository.GetVentanaRetroactividadAsync(); } catch { _windowDays = 3; }

        try
        {
            var activos = await CatalogosCache.GetEmpleadosActivosAsync();
            _recursos = activos.Select(e => e.Nombre).ToList();
            if (_recursos.Count == 0) _recursos = [.. RecursosFallback];
        }
        catch { _recursos = [.. RecursosFallback]; }

        await PrecargarRecursoDelPuestoAsync();

        try { _catalogoClientes = await ClienteRepository.GetCatalogoAsync(); } catch { }

        try
        {
            var mods = await CatalogosCache.GetModalidadesActivasAsync();
            if (mods.Count > 0) _modalidades = mods.Select(m => m.Nombre).ToList();
        }
        catch { }

        try
        {
            var lugares = await CatalogosCache.GetLugaresTrabajoActivosAsync();
            if (lugares.Count > 0) _lugares = lugares.Select(l => l.Nombre).ToList();
        }
        catch { }

        _browserSupportsVoice = await VoiceInput.IsSupportedAsync();
        if (_browserSupportsVoice)
            _iaDisponible = await VozRepository.EstaDisponibleAsync();

        _dotNetRef = DotNetObjectReference.Create(this);
        if (_browserSupportsVoice)
            await VoiceInput.InitAsync();
    }

    /// <summary>
    /// El recurso sale del puesto del usuario (claim "puesto" del JWT), para que no elija
    /// a mano de quien depende su primera aprobacion. <b>Precarga, no bloquea</b>: quien no
    /// tenga puesto asignado —hoy la mayoria— sigue eligiendolo del selector.
    /// </summary>
    private async Task PrecargarRecursoDelPuestoAsync()
    {
        try
        {
            var estado = await AuthState.GetAuthenticationStateAsync();
            _puestoDelUsuario = estado.User.FindFirst("puesto")?.Value;

            // Solo si el puesto sigue en el catalogo activo: si se desactivo, que elija.
            if (!string.IsNullOrWhiteSpace(_puestoDelUsuario) && _recursos.Contains(_puestoDelUsuario))
                _model.Recurso = _puestoDelUsuario;
            else
                _puestoDelUsuario = null;
        }
        catch { _puestoDelUsuario = null; }
    }

    private string? _puestoDelUsuario;

    private async Task HandleSuggestionSelected(RegistroRecienteResponse s)
    {
        // La sugerencia trae el ProyectoId, asi que tambien se resuelve su cliente.
        _model.ProyectoId = s.ProyectoId;
        _model.ClienteId  = _catalogoClientes
            .FirstOrDefault(c => c.ProyectosActivos.Any(p => p.Id == s.ProyectoId))?.Id;
        _model.Modalidad  = s.Modalidad;
        _model.Recurso    = s.Recurso;
        _model.Lugar      = s.Lugar;
        _model.Descripcion = s.Descripcion;
        await CargarRegistroExistenteAsync();
    }

    private IEnumerable<ProyectoActivoResponse> ProyectosDelCliente =>
        _catalogoClientes.FirstOrDefault(c => c.Id == _model.ClienteId)?.ProyectosActivos
        ?? Enumerable.Empty<ProyectoActivoResponse>();

    /// <summary>Al cambiar de cliente se limpia el proyecto: ya no pertenece al nuevo cliente.</summary>
    private void HandleClienteChanged(int? clienteId)
    {
        _model.ClienteId     = clienteId;
        _model.ProyectoId    = null;
        _registroExistente   = null;
        StateHasChanged();
    }

    private async Task HandleProyectoChanged(int? proyectoId)
    {
        _model.ProyectoId = proyectoId;
        await CargarRegistroExistenteAsync();
    }

    // ── Registro ya existente de ese dia y proyecto ───────────────────────────

    /// <summary>
    /// El backend hace upsert: un dia y proyecto admiten hasta tres horarios, pero un
    /// horario ya guardado no se puede pisar. Saber cual esta ocupado evita que el usuario
    /// vuelva a llenar el Horario 1 y choque contra un error que no explica nada.
    /// </summary>
    private HistorialRegistroResponse? _registroExistente;

    private bool BloqueOcupado(int numero) => EntradaGuardada(numero).HasValue;

    private bool TodosLosHorariosOcupados =>
        Enumerable.Range(1, TotalHorarios).All(BloqueOcupado);

    private TimeSpan? EntradaGuardada(int numero) => _registroExistente is null ? null : numero switch
    {
        1 => _registroExistente.HoraEntrada1?.ToTimeSpan(),
        2 => _registroExistente.HoraEntrada2?.ToTimeSpan(),
        3 => _registroExistente.HoraEntrada3?.ToTimeSpan(),
        _ => null
    };

    private TimeSpan? SalidaGuardada(int numero) => _registroExistente is null ? null : numero switch
    {
        1 => _registroExistente.HoraSalida1?.ToTimeSpan(),
        2 => _registroExistente.HoraSalida2?.ToTimeSpan(),
        3 => _registroExistente.HoraSalida3?.ToTimeSpan(),
        _ => null
    };

    private async Task CargarRegistroExistenteAsync()
    {
        _registroExistente = null;

        if (_fecha is null || _model.ProyectoId is null)
        {
            StateHasChanged();
            return;
        }

        var fecha = DateOnly.FromDateTime(_fecha.Value);
        try
        {
            // Se consulta solo ese dia; el filtro por proyecto se hace aqui porque el dia
            // puede tener varios registros, uno por proyecto.
            var historial = await RegistroHorasRepository.GetHistorialAsync(1, 50, fecha, fecha);
            _registroExistente = historial.Items.FirstOrDefault(r => r.ProyectoId == _model.ProyectoId);

            // Los horarios ya guardados no se reenvian: el backend los rechazaria.
            if (_registroExistente is not null)
                for (var n = 1; n <= TotalHorarios; n++)
                    if (BloqueOcupado(n)) { _model.SetEntrada(n, null); _model.SetSalida(n, null); }
        }
        catch { /* si falla la consulta se sigue sin el aviso, el backend igual valida */ }

        StateHasChanged();
    }

    private static int Minutos(TimeOnly? entrada, TimeOnly? salida) =>
        entrada.HasValue && salida.HasValue
            ? (int)(salida.Value - entrada.Value).TotalMinutes
            : 0;

    private static int Minutos(TimeSpan? entrada, TimeSpan? salida) =>
        entrada.HasValue && salida.HasValue
            ? Math.Max(0, (int)(salida.Value - entrada.Value).TotalMinutes)
            : 0;

    private string DuracionBloque(int numero)
    {
        var minutos = Minutos(_model.GetEntrada(numero), _model.GetSalida(numero));
        return minutos > 0 ? $"{minutos / 60}h {minutos % 60:00}m" : "—";
    }

    private string TotalFormulario
    {
        get
        {
            var minutos = Enumerable.Range(1, TotalHorarios)
                .Sum(n => Minutos(_model.GetEntrada(n), _model.GetSalida(n)));
            return $"{minutos / 60}h {minutos % 60:00}m";
        }
    }

    private void LimpiarBloque(int numero)
    {
        _model.SetEntrada(numero, null);
        _model.SetSalida(numero, null);
    }

    /// <summary>Filas que el usuario pidio ver; las que tienen datos o ya estan guardadas se muestran siempre.</summary>
    private int _tramosSolicitados = 2;

    private bool BloqueConDatos(int numero) =>
        BloqueOcupado(numero) || _model.GetEntrada(numero).HasValue || _model.GetSalida(numero).HasValue;

    private int TramosVisibles
    {
        get
        {
            var ultimoConDatos = Enumerable.Range(1, TotalHorarios).LastOrDefault(BloqueConDatos);
            // Si todas las filas visibles ya estan guardadas, se ofrece la siguiente libre.
            var ultimoOcupado = Enumerable.Range(1, TotalHorarios).LastOrDefault(BloqueOcupado);
            var minimo = ultimoOcupado > 0 ? ultimoOcupado + 1 : 1;
            return Math.Clamp(Math.Max(Math.Max(_tramosSolicitados, ultimoConDatos), minimo), 1, TotalHorarios);
        }
    }

    private void AgregarTramo() => _tramosSolicitados = Math.Min(TotalHorarios, TramosVisibles + 1);

    private void QuitarTramo(int numero)
    {
        LimpiarBloque(numero);
        if (numero == TramosVisibles && numero > 1)
            _tramosSolicitados = numero - 1;
    }

    private string DuracionGuardada(int numero)
    {
        var minutos = Minutos(EntradaGuardada(numero), SalidaGuardada(numero));
        return minutos > 0 ? $"{minutos / 60}h {minutos % 60:00}m" : "—";
    }

    private static string TsToStr(TimeSpan? t) =>
        t.HasValue ? t.Value.ToString(@"hh\:mm") : string.Empty;

    private static TimeSpan? ParseTs(string? s) =>
        TimeSpan.TryParse(s, out var t) ? t : null;

    private bool IsInvalidBloque(int numero)
    {
        var entrada = _model.GetEntrada(numero);
        var salida  = _model.GetSalida(numero);
        return entrada.HasValue && salida.HasValue && salida.Value <= entrada.Value;
    }

    /// <summary>Paso del input time en segundos: 900 = 15 min, para que el selector nativo ofrezca cuartos de hora.</summary>
    private const string CuartoHoraStep = "900";

    private const int MinutosPorCuarto = 15;

    /// <summary>Limite de RegistrosHoras.Descripcion (NVARCHAR(1000)).</summary>
    private const int MaxDescripcion = 1000;

    private bool DescripcionExcedida => (_model.Descripcion?.Length ?? 0) > MaxDescripcion;

    /// <summary>
    /// El atributo step del input no impide teclear un valor libre, asi que el cuarto de
    /// hora tambien se valida aqui antes de dejar guardar.
    /// </summary>
    private static bool NoEsCuartoDeHora(TimeSpan? valor) =>
        valor.HasValue && valor.Value.Minutes % MinutosPorCuarto != 0;

    private bool HayMinutoInvalido() =>
        Enumerable.Range(1, TotalHorarios)
            .Any(n => NoEsCuartoDeHora(_model.GetEntrada(n)) || NoEsCuartoDeHora(_model.GetSalida(n)));

    private bool HayBloqueInvalido() =>
        Enumerable.Range(1, TotalHorarios).Any(IsInvalidBloque);

    private bool TieneAlMenosUnTurno() =>
        Enumerable.Range(1, TotalHorarios).Any(n => _model.GetEntrada(n).HasValue);

    private void HandleModalidadKey(KeyboardEventArgs e)
    {
        if (e.Key is not ("ArrowLeft" or "ArrowRight" or "ArrowUp" or "ArrowDown") || _modalidades.Count == 0)
            return;
        var current = _modalidades.IndexOf(_model.Modalidad ?? _modalidades[0]);
        if (current < 0) current = 0;
        _model.Modalidad = e.Key is "ArrowRight" or "ArrowDown"
            ? _modalidades[(current + 1) % _modalidades.Count]
            : _modalidades[(current - 1 + _modalidades.Count) % _modalidades.Count];
        StateHasChanged();
    }

    /// <summary>Descarta lo que el usuario llevaba tecleado y recarga el estado guardado
    /// de la fecha actual, igual que si acabara de seleccionarla.</summary>
    private async Task CancelarAsync()
    {
        _model.Reset();
        _model.Recurso    = _puestoDelUsuario;
        _touchedModalidad = false;
        _guardado         = false;
        _response         = null;
        _errorMessage     = null;
        _sinTurno         = false;
        _form.ResetValidation();
        await CargarRegistroExistenteAsync();
    }

    private bool EsFueraDeVentana => _dateAvailability == DateAvailability.OutOfWindow && _fecha.HasValue;

    /// <summary>El boton dice lo que realmente va a pasar: guardar, agregar o pedir permiso.</summary>
    private string TextoBotonGuardar =>
        EsFueraDeVentana            ? L["Reg_SendWithRequest"].Value :
        _registroExistente is not null ? L["Reg_AddShift"].Value
                                    : L["Reg_SaveShift"].Value;

    /// <summary>
    /// Pide la justificacion y envia la solicitud con el registro adjunto. Al aprobarse,
    /// el backend crea el registro solo: el empleado no vuelve a llenar el formulario.
    /// </summary>
    private async Task EnviarSolicitudConRegistroAsync(DateOnly fecha)
    {
        var parameters = new DialogParameters<KpgExceptionDialog>
        {
            { x => x.Fecha, fecha },
            { x => x.TraeRegistro, true }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
        var dialog  = await DialogService.ShowAsync<KpgExceptionDialog>(string.Empty, parameters, options);
        var result  = await dialog.Result;

        if (result is not { Canceled: false, Data: string justificacion } || string.IsNullOrWhiteSpace(justificacion))
            return;

        _isSaving     = true;
        _errorMessage = null;

        try
        {
            var creada = await SolicitudExcepcionRepository.CreateAsync(
                new CreateSolicitudExcepcionRequest(
                    fecha, justificacion,
                    _model.ProyectoId,
                    ToTimeOnly(_model.HoraEntrada1), ToTimeOnly(_model.HoraSalida1),
                    ToTimeOnly(_model.HoraEntrada2), ToTimeOnly(_model.HoraSalida2),
                    ToTimeOnly(_model.HoraEntrada3), ToTimeOnly(_model.HoraSalida3),
                    _model.Modalidad, _model.Recurso, _model.Lugar, _model.Descripcion));

            if (creada is null)
            {
                _errorMessage = L["Exc_ErrorSend"];
                return;
            }

            _excepcionEnviada = true;
            _excepcionFecha   = fecha;

            // El registro quedo en manos del aprobador: limpiar evita reenviar lo mismo.
            _model.Reset();
            _touchedModalidad = false;
            _form.ResetValidation();
        }
        catch (UnauthorizedAccessException) { _errorMessage = L["Error_SessionExpired"]; }
        catch { _errorMessage = L["Exc_ErrorSend"]; }
        finally { _isSaving = false; }
    }

    private async Task SaveAsync()
    {
        _touchedModalidad = true;
        await _form.Validate();
        _sinTurno = false;

        // Sin bloques libres no hay nada que enviar: el dia ya tiene sus tres horarios.
        if (TodosLosHorariosOcupados) { _errorMessage = L["Reg_DayFull"]; return; }

        if (!TieneAlMenosUnTurno()) { _sinTurno = true; return; }
        if (HayBloqueInvalido()) return;
        if (HayMinutoInvalido()) return;
        if (!_form.IsValid) return;
        if (_model.ProyectoId is null) return;
        if (string.IsNullOrWhiteSpace(_model.Modalidad)) return;
        if (!_fecha.HasValue) return;

        // Fuera de ventana el registro no se guarda directo, pero tampoco se pierde:
        // viaja adjunto a la solicitud, ya validado con las mismas reglas de arriba.
        if (EsFueraDeVentana)
        {
            _guardado         = false;
            _response         = null;
            _excepcionEnviada = false;
            await EnviarSolicitudConRegistroAsync(DateOnly.FromDateTime(_fecha.Value));
            return;
        }

        // El resultado del guardado anterior debe limpiarse ANTES de intentar el nuevo:
        // si no, un guardado fallido deja visible el banner de exito del anterior con el
        // total de horas vacio (porque _response ya quedo en null).
        _guardado     = false;
        _response     = null;
        _isSaving     = true;
        _errorMessage = null;

        try
        {
            var request = new CreateRegistroHorasRequest(
                DateOnly.FromDateTime(_fecha!.Value),
                ToTimeOnly(_model.HoraEntrada1),
                ToTimeOnly(_model.HoraSalida1),
                ToTimeOnly(_model.HoraEntrada2),
                ToTimeOnly(_model.HoraSalida2),
                ToTimeOnly(_model.HoraEntrada3),
                ToTimeOnly(_model.HoraSalida3),
                _model.ProyectoId!.Value,
                _model.Modalidad!,
                _model.Recurso!,
                _model.Descripcion!,
                _model.Lugar!);

            var (creado, error) = await RegistroHorasRepository.CreateAsync(request);
            if (creado is null)
            {
                // El motivo que da el backend ("el horario 1 ya fue registrado") le dice al
                // usuario que hacer; el texto generico lo dejaba adivinando.
                _errorMessage = error ?? L["Reg_ErrorSave"];
                await CargarRegistroExistenteAsync();
                return;
            }

            _response = creado;
            _guardado = true;

            // Limpiar el formulario evita que el usuario reenvie el mismo dia/proyecto,
            // que el backend rechaza por inmutabilidad del bloque ya registrado.
            _model.Reset();
            _model.Recurso = _puestoDelUsuario;   // vuelve solo, no hay que reelegirlo
            _registroExistente = null;
            _touchedModalidad = false;
            _form.ResetValidation();

            if (_fecha.HasValue)
                await OnGuardado.InvokeAsync(DateOnly.FromDateTime(_fecha.Value));
        }
        catch (UnauthorizedAccessException) { _errorMessage = L["Error_SessionExpired"]; }
        catch { _errorMessage = L["Reg_ErrorSaveGeneral"]; }
        finally { _isSaving = false; }
    }

    private static TimeOnly? ToTimeOnly(TimeSpan? value) =>
        value.HasValue ? TimeOnly.FromTimeSpan(value.Value) : null;

    public async Task SetFechaAsync(DateOnly fecha, List<DateOnly>? excepcionesAprobadas = null)
    {
        _fecha    = fecha.ToDateTime(TimeOnly.MinValue);
        var today   = DateOnly.FromDateTime(DateTime.Today);
        var earliest = BusinessDayCalculator.GetEarliestAllowedDate(today, _windowDays);

        _dateAvailability = excepcionesAprobadas?.Contains(fecha) == true
            ? DateAvailability.Retroactive
            : BusinessDayCalculator.GetAvailability(fecha, today, earliest);

        _guardado         = false;
        _errorMessage     = null;
        _excepcionEnviada = false;
        await CargarRegistroExistenteAsync();
    }

    // ── Voz ───────────────────────────────────────────────────────────────────

    private enum VoiceState { Idle, Listening, Processing }
    private VoiceState _voiceState = VoiceState.Idle;
    private bool _browserSupportsVoice = true;
    private List<string> _voiceCamposNoDetectados = [];
    private DotNetObjectReference<KpgShiftForm>? _dotNetRef;

    /// <summary>True si el backend tiene configurada la interpretacion por IA.</summary>
    private bool _iaDisponible;

    private async Task ToggleVoiceAsync()
    {
        if (_voiceState == VoiceState.Listening)
        {
            await VoiceInput.StopAsync();
            _voiceState = VoiceState.Idle;
            return;
        }

        // Pedido del cliente: al empezar a dictar el formulario arranca limpio. Si no, lo
        // dictado se mezclaba con lo que hubiera quedado y no se sabia que venia de donde.
        _model.Reset();
        _model.Recurso           = _puestoDelUsuario;
        _touchedModalidad        = false;
        _guardado                = false;
        _response                = null;
        _errorMessage            = null;
        _sinTurno                = false;
        _voiceCamposNoDetectados = [];
        _form.ResetValidation();

        _voiceState = VoiceState.Listening;
        await VoiceInput.StartAsync(_dotNetRef!, "es-CO");
    }

    [JSInvokable]
    public async Task OnTranscriptReceived(string transcript)
    {
        _voiceState = VoiceState.Processing;
        await InvokeAsync(StateHasChanged);

        Console.WriteLine($"[VoiceInput] Transcript: {transcript}");

        try
        {
            // La IA entiende el lenguaje natural mucho mejor que las reglas, pero necesita
            // red y credenciales. Si no responde, el parser local resuelve igual las frases
            // habituales: el dictado nunca queda inservible por una falla de red.
            var result = await InterpretarConIaAsync(transcript)
                      ?? VoiceParser.Parse(transcript, BuildVoiceCatalog());

            ApplyVoiceResult(result);
            // El dictado pudo cambiar fecha o proyecto: hay que releer lo ya registrado.
            await CargarRegistroExistenteAsync();
        }
        catch { }

        // Volver a Listening para que el mic siga activo entre frases (auto-restart en JS)
        _voiceState = VoiceState.Listening;
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnVoiceError(string error)
    {
        _voiceState = VoiceState.Idle;
        _voiceCamposNoDetectados = [$"Error de micrófono: {error}. Verifica los permisos del navegador."];
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnRecognitionEnded()
    {
        if (_voiceState is VoiceState.Listening or VoiceState.Processing)
            _voiceState = VoiceState.Idle;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Interpreta el dictado con la IA del backend. Devuelve null cuando no esta
    /// configurada o no responde, para que quien llama caiga al parser de reglas.
    /// </summary>
    private async Task<VoiceParseResult?> InterpretarConIaAsync(string transcript)
    {
        if (!_iaDisponible) return null;

        var r = await VozRepository.InterpretarAsync(transcript);
        if (r is null) return null;

        return new VoiceParseResult
        {
            Fecha        = r.Fecha,
            HoraEntrada1 = r.HoraEntrada1,
            HoraSalida1  = r.HoraSalida1,
            HoraEntrada2 = r.HoraEntrada2,
            HoraSalida2  = r.HoraSalida2,
            HoraEntrada3 = r.HoraEntrada3,
            HoraSalida3  = r.HoraSalida3,
            Cliente      = r.Cliente,
            Proyecto     = r.Proyecto,
            Modalidad    = r.Modalidad,
            Recurso      = r.Recurso,
            Lugar        = r.Lugar,
            Descripcion  = r.Descripcion
        };
    }

    private VoiceCatalog BuildVoiceCatalog() => new()
    {
        Clientes            = _catalogoClientes.Select(c => c.Nombre).ToList(),
        ProyectosPorCliente = _catalogoClientes.ToDictionary(c => c.Nombre, c => c.ProyectosActivos.Select(p => p.Nombre).ToList()),
        Modalidades         = _modalidades,
        Recursos            = _recursos,
        Lugares             = _lugares
    };

    private void ApplyVoiceResult(VoiceParseResult r)
    {
        if (r.Fecha.HasValue)
            _fecha = r.Fecha.Value.ToDateTime(TimeOnly.MinValue);

        if (r.HoraEntrada1.HasValue) _model.HoraEntrada1 = r.HoraEntrada1.Value.ToTimeSpan();
        if (r.HoraSalida1.HasValue)  _model.HoraSalida1  = r.HoraSalida1.Value.ToTimeSpan();
        if (r.HoraEntrada2.HasValue) _model.HoraEntrada2 = r.HoraEntrada2.Value.ToTimeSpan();
        if (r.HoraSalida2.HasValue)  _model.HoraSalida2  = r.HoraSalida2.Value.ToTimeSpan();
        if (r.HoraEntrada3.HasValue) _model.HoraEntrada3 = r.HoraEntrada3.Value.ToTimeSpan();
        if (r.HoraSalida3.HasValue)  _model.HoraSalida3  = r.HoraSalida3.Value.ToTimeSpan();

        if (r.Cliente is not null)
        {
            var cliente = _catalogoClientes.FirstOrDefault(
                c => c.Nombre.Equals(r.Cliente, StringComparison.OrdinalIgnoreCase));
            HandleClienteChanged(cliente?.Id);
        }
        if (r.Proyecto is not null)
        {
            _model.ProyectoId = ProyectosDelCliente.FirstOrDefault(
                p => p.Nombre.Equals(r.Proyecto, StringComparison.OrdinalIgnoreCase))?.Id;
        }
        if (r.Modalidad is not null) { _model.Modalidad = r.Modalidad; _touchedModalidad = true; }
        if (r.Recurso is not null)  _model.Recurso     = r.Recurso;
        if (r.Lugar is not null)    _model.Lugar       = r.Lugar;
        if (r.Descripcion is not null) _model.Descripcion = r.Descripcion;

        _voiceCamposNoDetectados = ComputeCamposFaltantes();
    }

    private List<string> ComputeCamposFaltantes()
    {
        var faltantes = new List<string>();
        if (_fecha is null)                                                        faltantes.Add("Fecha");
        if (!TieneAlMenosUnTurno())                                               faltantes.Add("Horas");
        if (_model.ClienteId is null)                                             faltantes.Add("Cliente");
        if (_model.ProyectoId is null)                                            faltantes.Add("Proyecto");
        if (string.IsNullOrWhiteSpace(_model.Modalidad))                          faltantes.Add("Modalidad");
        if (string.IsNullOrWhiteSpace(_model.Recurso))                            faltantes.Add("Recurso");
        if (string.IsNullOrWhiteSpace(_model.Lugar))                              faltantes.Add("Lugar");
        if (string.IsNullOrWhiteSpace(_model.Descripcion))                        faltantes.Add("Descripción");
        return faltantes;
    }

    public async ValueTask DisposeAsync()
    {
        await VoiceInput.StopAsync();
        _dotNetRef?.Dispose();
    }

    private sealed class DayFormModel
    {
        public TimeSpan? HoraEntrada1 { get; set; }
        public TimeSpan? HoraSalida1  { get; set; }
        public TimeSpan? HoraEntrada2 { get; set; }
        public TimeSpan? HoraSalida2  { get; set; }
        public TimeSpan? HoraEntrada3 { get; set; }
        public TimeSpan? HoraSalida3  { get; set; }
        public int?      ClienteId   { get; set; }
        public int?      ProyectoId  { get; set; }
        public string?   Modalidad   { get; set; }
        public string?   Recurso     { get; set; }
        public string?   Descripcion { get; set; }
        public string?   Lugar       { get; set; }

        public TimeSpan? GetEntrada(int numero) => numero switch
        {
            1 => HoraEntrada1, 2 => HoraEntrada2, 3 => HoraEntrada3, _ => null
        };

        public TimeSpan? GetSalida(int numero) => numero switch
        {
            1 => HoraSalida1, 2 => HoraSalida2, 3 => HoraSalida3, _ => null
        };

        public void SetEntrada(int numero, TimeSpan? valor)
        {
            switch (numero)
            {
                case 1: HoraEntrada1 = valor; break;
                case 2: HoraEntrada2 = valor; break;
                case 3: HoraEntrada3 = valor; break;
            }
        }

        public void SetSalida(int numero, TimeSpan? valor)
        {
            switch (numero)
            {
                case 1: HoraSalida1 = valor; break;
                case 2: HoraSalida2 = valor; break;
                case 3: HoraSalida3 = valor; break;
            }
        }

        /// <summary>Deja el formulario listo para un nuevo registro conservando la fecha.</summary>
        public void Reset()
        {
            HoraEntrada1 = HoraSalida1 = null;
            HoraEntrada2 = HoraSalida2 = null;
            HoraEntrada3 = HoraSalida3 = null;
            ClienteId = ProyectoId = null;
            Modalidad = Recurso = Descripcion = Lugar = null;
        }
    }
