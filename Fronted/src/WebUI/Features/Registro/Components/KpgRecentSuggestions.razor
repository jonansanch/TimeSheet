@inject IRegistroHorasRepository RegistroHorasRepository
@inject IStringLocalizer<SharedResource> L

@if (_isLoading)
{
    <MudProgressLinear Indeterminate="true" Size="Size.Small" Class="mb-2" />
}
else if (_sugerencias.Count > 0)
{
    <ul class="kpg-recent-suggestions">
        @foreach (var s in _sugerencias)
        {
            <li>
                <button type="button" class="kpg-list-row"
                        @onclick="@(() => OnSuggestionSelected.InvokeAsync(s))"
                        aria-label="@($"{L["Reg_ApplySuggestion"].Value}: {s.Cliente} - {s.Proyecto}")">
                    <span class="kpg-list-row__icon"><MudIcon Icon="@Icons.Material.Outlined.Business" Size="Size.Small" /></span>
                    <span class="kpg-list-row__copy">
                        <span class="kpg-list-row__title">@s.Cliente</span>
                        <span class="kpg-list-row__meta">@s.Proyecto</span>
                    </span>
                </button>
            </li>
        }
    </ul>
}
else if (!_isLoading)
{
    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Reg_NoRecent"]</MudText>
}

@code {
    [Parameter]
    public EventCallback<RegistroRecienteResponse> OnSuggestionSelected { get; set; }

    private List<RegistroRecienteResponse> _sugerencias = [];
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _sugerencias = await RegistroHorasRepository.GetRecientesAsync(5);
        }
        catch
        {
            _sugerencias = [];
        }
        finally
        {
            _isLoading = false;
        }
    }
}
