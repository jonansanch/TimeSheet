@page "/mis-registros"
@attribute [Authorize(Roles = $"{Roles.Empleado},{Roles.Supervisor},{Roles.Gerente},{Roles.Admin}")]
@inject IRegistroHorasRepository RegistroHorasRepository
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject CurrentUserService CurrentUserService
@inject IStringLocalizer<SharedResource> L
@inject ISnackbar Snackbar

<PageTitle>@L["Hist_Title"] - KPG Timesheet</PageTitle>

<MudStack Spacing="3">
    <MudBreadcrumbs Items="_breadcrumbs" Separator=">" Class="pa-0" />
    <div>
        <MudText Typo="Typo.h4" Style="font-family:Poppins,sans-serif;font-weight:600;">
            @L["Hist_Title"]
        </MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @L["Hist_Subtitle"]
        </MudText>
    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Dense="true" aria-live="polite">@_errorMessage</MudAlert>
    }

    <MudPaper Elevation="1" Class="pa-3">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudSelect T="int"
                       Label="@L["Label_Month"]"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Value="_mes"
                       ValueChanged="OnMesChangedAsync"
                       Style="max-width:200px;"
                       aria-label="@L["Label_Month"]">
                @foreach (var (numero, nombre) in _meses)
                {
                    <MudSelectItem Value="@numero">@nombre</MudSelectItem>
                }
            </MudSelect>
            <MudNumericField T="int"
                             Label="@L["Label_Year"]"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Value="_anio"
                             ValueChanged="OnAnioChangedAsync"
                             Min="2020"
                             Max="2099"
                             Style="max-width:120px;"
                             aria-label="@L["Label_Year"]" />
            <MudTooltip Text="@(L["Hist_CurrentMonth"].Value)">
                <MudButton Variant="Variant.Text"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Today"
                           OnClick="VolverAlMesActualAsync">
                    @L["Hist_CurrentMonth"]
                </MudButton>
            </MudTooltip>
        </MudStack>
    </MudPaper>

    <MudDataGrid @ref="_grid"
                 T="HistorialRegistroResponse"
                 ServerData="CargarDatosAsync"
                 Dense="true"
                 Filterable="false"
                 SortMode="SortMode.None"
                 RowsPerPage="50">
        <NoRecordsContent>
            <MudAlert Severity="Severity.Info" Icon="@Icons.Material.Filled.EventBusy" Class="ma-4">
                <MudText Typo="Typo.body1">@L["Hist_NoRecords"]</MudText>
                <MudText Typo="Typo.body2" Class="mb-2">@L["Hist_NoRecordsHint"]</MudText>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           Size="Size.Small"
                           OnClick="@(() => Navigation.NavigateTo("/registro"))">
                    @L["Btn_RegisterHours"]
                </MudButton>
            </MudAlert>
        </NoRecordsContent>
        <Columns>
            <PropertyColumn Property="x => x.FechaRegistro" Title="@L["Label_Date"]" Sortable="false">
                <CellTemplate>
                    @context.Item.FechaRegistro.ToString("dd/MM/yyyy")
                </CellTemplate>
            </PropertyColumn>
            <TemplateColumn Title="@L["Reg_Shift1"]" Sortable="false" CellStyle="white-space:nowrap;">
                <CellTemplate>
                    @if (context.Item.HoraEntrada1.HasValue && context.Item.HoraSalida1.HasValue)
                    {
                        @($"{context.Item.HoraEntrada1.Value:HH\\:mm} – {context.Item.HoraSalida1.Value:HH\\:mm}")
                    }
                    else
                    {
                        <MudText Color="Color.Secondary">—</MudText>
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="@L["Reg_Shift2"]" Sortable="false" CellStyle="white-space:nowrap;">
                <CellTemplate>
                    @if (context.Item.HoraEntrada2.HasValue && context.Item.HoraSalida2.HasValue)
                    {
                        @($"{context.Item.HoraEntrada2.Value:HH\\:mm} – {context.Item.HoraSalida2.Value:HH\\:mm}")
                    }
                    else
                    {
                        <MudText Color="Color.Secondary">—</MudText>
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="@L["Reg_Shift3"]" Sortable="false" CellStyle="white-space:nowrap;">
                <CellTemplate>
                    @if (context.Item.HoraEntrada3.HasValue && context.Item.HoraSalida3.HasValue)
                    {
                        @($"{context.Item.HoraEntrada3.Value:HH\\:mm} – {context.Item.HoraSalida3.Value:HH\\:mm}")
                    }
                    else
                    {
                        <MudText Color="Color.Secondary">—</MudText>
                    }
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.Cliente" Title="@L["Label_Client"]" />
            <PropertyColumn Property="x => x.Proyecto" Title="@L["Label_Project"]" />
            <PropertyColumn Property="x => x.Recurso" Title="@L["Label_Resource"]" Sortable="false" />
            <PropertyColumn Property="x => x.Modalidad" Title="@L["Label_Modality"]" Sortable="false" />
            <PropertyColumn Property="x => x.Descripcion" Title="@L["Label_Description"]" Sortable="false" />
            <TemplateColumn Title="" Sortable="false">
                <CellTemplate>
                    @if (_puedeEditar)
                    {
                        <MudTooltip Text="@(L["Btn_Edit"].Value)">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           aria-label="@L["Btn_Edit"]"
                                           Disabled="_isEditing"
                                           OnClick="@(() => AbrirEditarDescripcionAsync(context.Item))" />
                        </MudTooltip>
                    }
                    <MudTooltip Text="@(L["Btn_Delete"].Value)">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       aria-label="@L["Btn_Delete"]"
                                       Disabled="_isDeleting"
                                       OnClick="@(() => ConfirmarEliminarAsync(context.Item))" />
                    </MudTooltip>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="HistorialRegistroResponse" PageSizeOptions="new[] { 10, 20, 50, 100 }" RowsPerPageString="@L["Pager_RowsPerPage"]" />
        </PagerContent>
    </MudDataGrid>

    @if (_totalCount > 0)
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-1">
            <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Outlined">
                @_totalCount @L["Rep_Records"]
            </MudChip>
        </MudStack>
    }

    <MudMessageBox @ref="_msgBox"
                   Title="@L["Hist_DeleteTitle"]"
                   CancelText="@L["Btn_Cancel"]">
        <MessageContent>
            @L["Hist_DeleteConfirm"]
            <b>@_pendiente?.FechaRegistro.ToString("dd/MM/yyyy")</b>?
            @L["Hist_DeleteCannotUndo"]
        </MessageContent>
        <YesButton>
            <MudButton Color="Color.Error" Variant="Variant.Filled">@L["Btn_Delete"]</MudButton>
        </YesButton>
    </MudMessageBox>
</MudStack>

@code {
    private BreadcrumbItem[] _breadcrumbs => [
        new(L["Nav_Home"].Value, "/"),
        new(L["Nav_MyRecords"].Value, null, disabled: true)
    ];

    private MudDataGrid<HistorialRegistroResponse>? _grid;
    private int _totalCount;
    private string? _errorMessage;
    private bool _isDeleting;
    private bool _isEditing;
    private bool _puedeEditar;
    private HistorialRegistroResponse? _pendiente;
    private MudMessageBox? _msgBox;

    protected override async Task OnInitializedAsync()
    {
        _puedeEditar = await CurrentUserService.IsInRoleAsync(Roles.Supervisor)
                    || await CurrentUserService.IsInRoleAsync(Roles.Admin);
    }

    // El filtro arranca en el mes en curso, que es lo que el usuario quiere ver al entrar.
    private int _mes  = DateTime.Today.Month;
    private int _anio = DateTime.Today.Year;

    private IEnumerable<(int Numero, string Nombre)> _meses =>
        Enumerable.Range(1, 12).Select(m => (m, CapitalizarMes(m)));

    private static string CapitalizarMes(int mes)
    {
        var nombre = new DateTime(2000, mes, 1)
            .ToString("MMMM", System.Globalization.CultureInfo.CurrentUICulture);
        return char.ToUpper(nombre[0]) + nombre[1..];
    }

    private async Task OnMesChangedAsync(int mes)
    {
        _mes = mes;
        await RecargarAsync();
    }

    private async Task OnAnioChangedAsync(int anio)
    {
        _anio = anio;
        await RecargarAsync();
    }

    private async Task VolverAlMesActualAsync()
    {
        _mes  = DateTime.Today.Month;
        _anio = DateTime.Today.Year;
        await RecargarAsync();
    }

    private async Task RecargarAsync()
    {
        if (_grid is not null)
            await _grid.ReloadServerData();
    }

    private async Task<GridData<HistorialRegistroResponse>> CargarDatosAsync(GridState<HistorialRegistroResponse> state)
    {
        _errorMessage = null;
        try
        {
            var desde = new DateOnly(_anio, _mes, 1);
            var hasta = desde.AddMonths(1).AddDays(-1);

            var resp = await RegistroHorasRepository.GetHistorialAsync(
                page: state.Page + 1,
                pageSize: state.PageSize,
                desde: desde,
                hasta: hasta);
            _totalCount = resp.TotalCount;
            return new GridData<HistorialRegistroResponse> { Items = resp.Items, TotalItems = resp.TotalCount };
        }
        catch
        {
            _errorMessage = L["Hist_ErrorLoad"];
            return new GridData<HistorialRegistroResponse> { Items = [], TotalItems = 0 };
        }
    }

    private async Task AbrirEditarDescripcionAsync(HistorialRegistroResponse item)
    {
        var parameters = new DialogParameters<KpgEditDescripcionDialog>
        {
            { x => x.DescripcionActual, item.Descripcion }
        };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseOnEscapeKey = true
        };
        var dialog = await DialogService.ShowAsync<KpgEditDescripcionDialog>(
            L["Hist_EditDescription"], parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: string nuevaDescripcion })
            await GuardarDescripcionAsync(item, nuevaDescripcion);
    }

    private async Task GuardarDescripcionAsync(HistorialRegistroResponse item, string nuevaDescripcion)
    {
        _isEditing = true;
        try
        {
            var ok = await RegistroHorasRepository.UpdateDescripcionAsync(item.Id, nuevaDescripcion);
            if (ok)
            {
                Snackbar.Add(L["Hist_DescUpdated"].Value, Severity.Success);
                await _grid!.ReloadServerData();
            }
            else
            {
                Snackbar.Add(L["Hist_ErrorUpdate"].Value, Severity.Error);
            }
        }
        catch
        {
            Snackbar.Add(L["Hist_ErrorUpdate"].Value, Severity.Error);
        }
        finally
        {
            _isEditing = false;
        }
    }

    private async Task ConfirmarEliminarAsync(HistorialRegistroResponse item)
    {
        _pendiente = item;
        StateHasChanged();
        var confirmed = await _msgBox!.ShowAsync();
        if (confirmed == true)
            await EliminarAsync(item);
        _pendiente = null;
    }

    private async Task EliminarAsync(HistorialRegistroResponse item)
    {
        _isDeleting = true;
        try
        {
            var success = await RegistroHorasRepository.DeleteAsync(item.Id);
            if (success)
            {
                Snackbar.Add(string.Format(L["Hist_DeletedMsg"], item.FechaRegistro.ToString("dd/MM/yyyy")), Severity.Success);
                await _grid!.ReloadServerData();
            }
            else
            {
                Snackbar.Add(L["Hist_ErrorDelete"].Value, Severity.Error);
            }
        }
        catch
        {
            Snackbar.Add(L["Hist_ErrorDelete"].Value, Severity.Error);
        }
        finally
        {
            _isDeleting = false;
        }
    }
}
