@page "/admin/usuarios"
@attribute [Authorize(Roles = Roles.Admin)]
@inject IUserAdminRepository Repo
@inject CatalogosCacheService CatalogosCache
@inject IDialogService DialogService
@inject IStringLocalizer<SharedResource> L
@inject ISnackbar Snackbar

<PageTitle>@L["Users_Title"] - KPG Timesheet</PageTitle>

<MudStack Spacing="3" Class="admin-page">
    <KpgPageHeader Title="@L["Users_Title"]" Subtitle="@L["Users_Subtitle"]">
        <Breadcrumbs><MudBreadcrumbs Items="_breadcrumbs" Separator=">" Class="pa-0" /></Breadcrumbs>
        <Actions><KpgButton StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="AbrirCrearAsync">@L["Users_NewUser"]</KpgButton></Actions>
    </KpgPageHeader>

    @if (_isLoading)
    {
        <KpgTableSkeleton />
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Dense="true" aria-live="polite">@_errorMessage</MudAlert>
    }
    else
    {
        @if (_usuarios.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Icon="@Icons.Material.Filled.People">
                @L["Users_ErrorLoad"]
            </MudAlert>
        }
        else
        {
            <KpgCard Compact="true" Class="admin-table-card">
            <MudDataGrid T="UserAdminResponse"
                         Items="_usuarios"
                         Dense="true"
                         Filterable="false"
                         SortMode="SortMode.Single"
                         QuickFilter="_quickFilter"
                         RowsPerPage="50">
                <ToolBarContent>
                    <div class="admin-toolbar" role="group" aria-label="@L["Common_Filters"]">
                        <MudTextField @bind-Value="_searchText"
                                      Placeholder="@L["Users_SearchPlaceholder"]"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      IconSize="Size.Small"
                                      Immediate="true"
                                      Class="admin-toolbar__search"
                                      aria-label="@L["Users_SearchPlaceholder"]" />
                        <div class="admin-toolbar__select">
                            <MudSelect T="string" @bind-Value="_filtroRol" Label="@L["Users_ColRole"]"
                                       Variant="Variant.Outlined" Margin="Margin.Dense">
                                <MudSelectItem Value="@((string?)null)">@L["Common_All"]</MudSelectItem>
                                @foreach (var rol in _usuarios.Select(u => u.Role).Distinct().OrderBy(r => r))
                                {
                                    <MudSelectItem Value="@rol">@rol</MudSelectItem>
                                }
                            </MudSelect>
                        </div>
                        <div class="admin-toolbar__select">
                            <MudSelect T="bool?" @bind-Value="_filtroActivo" Label="@L["Users_ColStatus"]"
                                       Variant="Variant.Outlined" Margin="Margin.Dense">
                                <MudSelectItem Value="@((bool?)null)">@L["Common_All"]</MudSelectItem>
                                <MudSelectItem Value="@((bool?)true)">@L["Label_Active"]</MudSelectItem>
                                <MudSelectItem Value="@((bool?)false)">@L["Label_Inactive"]</MudSelectItem>
                            </MudSelect>
                        </div>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                   OnClick="LimpiarFiltros">@L["Common_ClearFilters"]</MudButton>
                    </div>
                </ToolBarContent>
                <Columns>
                    <PropertyColumn Property="x => x.Email" Title="@L["Users_ColEmail"]" />
                    <PropertyColumn Property="x => x.NombreCompleto" Title="@L["Users_ColName"]" />
                    <PropertyColumn Property="x => x.Role" Title="@L["Users_ColRole"]" />
                    <TemplateColumn Title="@L["Users_Nationality"]" Sortable="false">
                        <CellTemplate>
                            @(PaisesIso.Nombre(context.Item.CodigoPais) ?? "-")
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="@L["Org_Position"]" Sortable="false">
                        <CellTemplate>
                            @(context.Item.PuestoNombre ?? "-")
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="@L["Org_DirectManager"]" Sortable="false">
                        <CellTemplate>
                            @(context.Item.SupervisorNombre ?? "-")
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="@L["Users_ColStatus"]" Sortable="true">
                        <CellTemplate>
                            <KpgEstadoChip Activo="@context.Item.IsActive" />
                            @if (!context.Item.IsActive && context.Item.DeactivatedAt is { } desactivado)
                            {
                                <span class="admin-cell-meta">@L["Users_ColDeactivated"]: @desactivado.ToLocalTime().ToString("dd/MM/yyyy")</span>
                            }
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="@L["Label_Actions"]" Sortable="false" CellClass="admin-actions" HeaderClass="admin-actions">
                        <CellTemplate>
                            <MudTooltip Text="@(L["Users_ChangeRole"].Value)">
                                <MudIconButton Icon="@Icons.Material.Filled.ManageAccounts"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               aria-label="@L["Users_ChangeRole"]"
                                               Disabled="_isProcesando"
                                               OnClick="@(() => AbrirCambiarRolAsync(context.Item))" />
                            </MudTooltip>
                            <MudTooltip Text="@(L["Org_AssignTitle"].Value)">
                                <MudIconButton Icon="@Icons.Material.Filled.AccountTree"
                                               Color="Color.Secondary"
                                               Size="Size.Small"
                                               aria-label="@L["Org_AssignTitle"]"
                                               Disabled="_isProcesando"
                                               OnClick="@(() => AbrirEstructuraAsync(context.Item))" />
                            </MudTooltip>
                            <MudTooltip Text="@(L["Users_ResetPasswordTitle"].Value)">
                                <MudIconButton Icon="@Icons.Material.Filled.LockReset"
                                               Color="Color.Warning"
                                               Size="Size.Small"
                                               aria-label="@L["Users_ResetPasswordTitle"]"
                                               Disabled="_isProcesando"
                                               OnClick="@(() => AbrirResetPasswordAsync(context.Item))" />
                            </MudTooltip>
                            @if (context.Item.IsActive)
                            {
                                <MudTooltip Text="@(L["Btn_Deactivate"].Value)">
                                    <MudIconButton Icon="@Icons.Material.Filled.CheckCircle"
                                                   Color="Color.Success"
                                                   Size="Size.Small"
                                                   aria-label="@L["Btn_Deactivate"]"
                                                   Disabled="_isProcesando"
                                                   OnClick="@(() => ConfirmarDesactivarAsync(context.Item))" />
                                </MudTooltip>
                            }
                            else
                            {
                                <MudTooltip Text="@(L["Btn_Activate"].Value)">
                                    <MudIconButton Icon="@Icons.Material.Filled.Block"
                                                   Color="Color.Default"
                                                   Size="Size.Small"
                                                   aria-label="@L["Btn_Activate"]"
                                                   Disabled="_isProcesando"
                                                   OnClick="@(() => ActivarAsync(context.Item))" />
                                </MudTooltip>
                            }
                            <MudTooltip Text="@(L["Btn_Delete"].Value)">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               aria-label="@L["Btn_Delete"]"
                                               Disabled="_isProcesando"
                                               OnClick="@(() => ConfirmarEliminarAsync(context.Item))" />
                            </MudTooltip>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <PagerContent>
                    <MudDataGridPager T="UserAdminResponse" PageSizeOptions="new[] { 5, 10, 20, 50, 100 }" RowsPerPageString="@L["Pager_RowsPerPage"]" InfoFormat="@L["Pager_InfoFormat"]" />
                </PagerContent>
            </MudDataGrid>
            </KpgCard>
        }
    }

    <MudMessageBox @ref="_msgBox" CancelText="@L["Btn_Cancel"]">
        <MessageContent>@_msgBoxContent</MessageContent>
        <YesButton>
            <MudButton Color="@_msgBoxColor" Variant="Variant.Filled">@L["Btn_Confirm"]</MudButton>
        </YesButton>
    </MudMessageBox>
</MudStack>

@code {
    private BreadcrumbItem[] _breadcrumbs => [
        new(L["Nav_Home"].Value, "/"),
        new(L["Nav_Admin"].Value, null, disabled: true),
        new(L["Nav_Users"].Value, null, disabled: true)
    ];

    private List<UserAdminResponse> _usuarios = [];
    private bool _isLoading = true;
    private bool _isProcesando;
    private string? _errorMessage;
    private MudMessageBox? _msgBox;
    private string _msgBoxContent = string.Empty;
    private Color _msgBoxColor = Color.Primary;
    private string _searchText = string.Empty;

    private string? _filtroRol;
    private bool? _filtroActivo;

    private Func<UserAdminResponse, bool> _quickFilter =>
        u => (string.IsNullOrWhiteSpace(_searchText)
                || u.Email.Contains(_searchText, StringComparison.OrdinalIgnoreCase)
                || (u.NombreCompleto?.Contains(_searchText, StringComparison.CurrentCultureIgnoreCase) ?? false))
            && (_filtroRol is null || u.Role == _filtroRol)
            && (_filtroActivo is null || u.IsActive == _filtroActivo);

    private void LimpiarFiltros()
    {
        _searchText   = string.Empty;
        _filtroRol    = null;
        _filtroActivo = null;
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var page = await Repo.GetUsersAsync(1, 100, "email", false);
            _usuarios = page.Items;
        }
        catch
        {
            _errorMessage = L["Users_ErrorLoad"];
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task AbrirCrearAsync()
    {
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseOnEscapeKey = true
        };
        var dialog = await DialogService.ShowAsync<KpgUserDialog>(L["Users_NewTitle"], options);
        var result = await dialog.Result;
        if (result?.Canceled != false || result.Data is not CreateUserRequest request)
            return;

        _isProcesando = true;

        try
        {
            var (ok, user, error) = await Repo.CreateAsync(request);
            if (ok && user is not null)
            {
                _usuarios.Add(user);
                _usuarios = _usuarios.OrderBy(u => u.Email).ToList();
                Snackbar.Add(L["Users_SavedOk"].Value, Severity.Success);
            }
            else
            {
                Snackbar.Add(error ?? L["Users_ErrorSave"].Value, Severity.Error);
            }
        }
        finally
        {
            _isProcesando = false;
        }
    }

    private async Task AbrirEstructuraAsync(UserAdminResponse item)
    {
        List<EmpleadoResponse> puestos;
        try { puestos = [.. await CatalogosCache.GetEmpleadosActivosAsync()]; }
        catch { puestos = []; }

        var parameters = new DialogParameters<KpgUserEstructuraDialog>
        {
            { x => x.UserId, item.Id },
            { x => x.NombreUsuario, item.NombreCompleto ?? item.Email },
            { x => x.SupervisorUserId, item.SupervisorUserId },
            { x => x.PuestoId, item.PuestoId },
            { x => x.CodigoPais, item.CodigoPais },
            { x => x.Usuarios, _usuarios },
            { x => x.Puestos, puestos }
        };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseOnEscapeKey = true
        };
        var dialog = await DialogService.ShowAsync<KpgUserEstructuraDialog>(string.Empty, parameters, options);
        var result = await dialog.Result;
        if (result?.Canceled != false || result.Data is not AsignarEstructuraRequest request)
            return;

        _isProcesando = true;

        try
        {
            var (ok, user, error) = await Repo.AsignarEstructuraAsync(item.Id, request);
            if (ok && user is not null)
            {
                // Se recarga la grilla en lugar de reemplazar la fila: el backend no
                // devuelve los nombres de supervisor y puesto, solo sus identificadores.
                await CargarAsync();
                Snackbar.Add(L["Org_AssignSaved"].Value, Severity.Success);
            }
            else
            {
                Snackbar.Add(error ?? L["Users_ErrorSave"].Value, Severity.Error);
            }
        }
        finally
        {
            _isProcesando = false;
        }
    }

    private async Task AbrirCambiarRolAsync(UserAdminResponse item)
    {
        var parameters = new DialogParameters<KpgUserRoleDialog>
        {
            { x => x.Email, item.Email },
            { x => x.CurrentRole, item.Role }
        };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseOnEscapeKey = true
        };
        var dialog = await DialogService.ShowAsync<KpgUserRoleDialog>(L["Users_ChangeRole"], parameters, options);
        var result = await dialog.Result;
        if (result?.Canceled != false || result.Data is not ChangeUserRoleRequest request)
            return;

        _isProcesando = true;

        try
        {
            var (ok, user, error) = await Repo.ChangeRoleAsync(item.Id, request);
            if (ok && user is not null)
            {
                ReemplazarUsuario(item, user);
                Snackbar.Add(L["Users_RoleChanged"].Value, Severity.Success);
            }
            else
            {
                Snackbar.Add(error ?? L["Users_ErrorSave"].Value, Severity.Error);
            }
        }
        finally
        {
            _isProcesando = false;
        }
    }

    private async Task ActivarAsync(UserAdminResponse item)
    {
        _isProcesando = true;

        try
        {
            var (ok, user) = await Repo.ActivateAsync(item.Id);
            if (ok && user is not null)
            {
                ReemplazarUsuario(item, user);
                Snackbar.Add(L["Users_SavedOk"].Value, Severity.Success);
            }
            else
            {
                Snackbar.Add(L["Users_ErrorSave"].Value, Severity.Error);
            }
        }
        finally
        {
            _isProcesando = false;
        }
    }

    private async Task ConfirmarDesactivarAsync(UserAdminResponse item)
    {
        _msgBoxContent = string.Format(L["Users_DeactivateConfirm"], item.Email);
        _msgBoxColor = Color.Warning;
        StateHasChanged();

        var confirmed = await _msgBox!.ShowAsync();
        if (confirmed != true) return;

        _isProcesando = true;

        try
        {
            var (ok, user) = await Repo.DeactivateAsync(item.Id);
            if (ok && user is not null)
            {
                ReemplazarUsuario(item, user);
                Snackbar.Add(L["Users_SavedOk"].Value, Severity.Success);
            }
            else
            {
                Snackbar.Add(L["Users_ErrorSave"].Value, Severity.Error);
            }
        }
        finally
        {
            _isProcesando = false;
        }
    }

    private async Task ConfirmarEliminarAsync(UserAdminResponse item)
    {
        _msgBoxContent = string.Format(L["Users_DeactivateConfirm"], item.Email);
        _msgBoxColor = Color.Error;
        StateHasChanged();

        var confirmed = await _msgBox!.ShowAsync();
        if (confirmed != true) return;

        _isProcesando = true;

        try
        {
            var (ok, result) = await Repo.DeleteAsync(item.Id);
            if (ok && result is not null)
            {
                if (result.WasHardDeleted)
                {
                    _usuarios.Remove(item);
                }
                else
                {
                    ReemplazarUsuario(item, item with { IsActive = false, DeactivatedAt = DateTimeOffset.Now });
                }
                Snackbar.Add(L["Users_SavedOk"].Value, Severity.Success);
            }
            else
            {
                Snackbar.Add(L["Users_ErrorSave"].Value, Severity.Error);
            }
        }
        finally
        {
            _isProcesando = false;
        }
    }

    private async Task AbrirResetPasswordAsync(UserAdminResponse item)
    {
        var parameters = new DialogParameters<KpgUserPasswordDialog>
        {
            { x => x.Email, item.Email }
        };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseOnEscapeKey = true
        };
        var dialog = await DialogService.ShowAsync<KpgUserPasswordDialog>(L["Users_ResetPasswordTitle"], parameters, options);
        var result = await dialog.Result;
        if (result?.Canceled != false || result.Data is not AdminResetPasswordRequest request)
            return;

        _isProcesando = true;

        try
        {
            var (ok, error) = await Repo.AdminResetPasswordAsync(item.Id, request);
            if (ok)
                Snackbar.Add(L["Users_PasswordResetOk"].Value, Severity.Success);
            else
                Snackbar.Add(error ?? L["Users_ErrorSave"].Value, Severity.Error);
        }
        finally
        {
            _isProcesando = false;
        }
    }

    private void ReemplazarUsuario(UserAdminResponse oldItem, UserAdminResponse newItem)
    {
        var idx = _usuarios.IndexOf(oldItem);
        if (idx >= 0)
            _usuarios[idx] = newItem;
    }
}
