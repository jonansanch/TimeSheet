@inject IStringLocalizer<SharedResource> L

@* El color indica de un vistazo si algo espera acción (ámbar), avanzó (azul),
   terminó (verde) o volvió al empleado (rojo). *@
<MudTooltip Text="@Detalle">
    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Style="@Estilo">
        @Texto
    </MudChip>
</MudTooltip>

@code {
    [Parameter, EditorRequired] public EstadoAprobacion Estado { get; set; }
    [Parameter] public int? NivelPendiente { get; set; }

    private string Texto => Estado switch
    {
        EstadoAprobacion.Pendiente      => L["Apr_StatePending"].Value,
        EstadoAprobacion.AprobadoNivel1 => $"{L["Apr_StateLevel1"].Value} 1/3",
        EstadoAprobacion.AprobadoNivel2 => $"{L["Apr_StateLevel2"].Value} 2/3",
        EstadoAprobacion.Aprobado       => $"{L["Apr_StateApproved"].Value} 3/3",
        _                                => L["Apr_StateRejected"].Value
    };

    private string Detalle => NivelPendiente is { } nivel
        ? string.Format(L["Apr_StateWaitingLevel"], nivel)
        : Texto;

    private string Estilo => Estado switch
    {
        EstadoAprobacion.Aprobado  => "background-color:var(--kpg-status-success);color:#fff;font-weight:600;",
        EstadoAprobacion.Rechazado => "background-color:var(--kpg-status-error);color:#fff;font-weight:600;",
        EstadoAprobacion.Pendiente => "background-color:var(--kpg-status-warning-fill);color:var(--kpg-text-primary);font-weight:600;",
        _                           => "background-color:var(--kpg-status-info);color:#fff;font-weight:600;"
    };
}
