@page "/aprobaciones"
@attribute [Authorize(Roles = $"{Roles.Supervisor},{Roles.Gerente},{Roles.Admin}")]
@using KPG.Timesheet.WebUI.Features.Aprobaciones.Components
@inject IAprobacionRepository Repo
@inject IRegistroHorasRepository RegistroHorasRepo
@inject IClienteRepository ClienteRepo
@inject IParametroSistemaRepository ParametroRepo
@inject IDialogService DialogService
@inject IStringLocalizer<SharedResource> L
@inject ISnackbar Snackbar

<PageTitle>@L["Apr_Title"] - KPG Timesheet</PageTitle>

<section class="approval-page">
    <KpgPageHeader Title="@L["Apr_Title"]" Subtitle="@L["Apr_Subtitle"]">
        <Breadcrumbs><MudBreadcrumbs Items="_breadcrumbs" Separator=">" Class="pa-0" /></Breadcrumbs>
        <Actions>
            <MudButton Variant="Variant.Outlined" Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.Close"
                       Disabled="@(_seleccionados.Count == 0 || _isProcesando)"
                       OnClick="RechazarSeleccionadosAsync">
                @L["Apr_BulkReject"] (@_seleccionados.Count)
            </MudButton>
            <KpgButton StartIcon="@Icons.Material.Filled.DoneAll" Disabled="@(_seleccionados.Count == 0 || _isProcesando)" OnClick="AprobarSeleccionadosAsync">@L["Apr_ApproveSelected"] (@_seleccionados.Count)</KpgButton>
        </Actions>
    </KpgPageHeader>

    <div class="approval-tabs" role="tablist" aria-label="@L["Apr_StatusTabs"]">
        <button type="button" role="tab" class="@TabClass(TabPendiente)"
                aria-selected="@(_tab == TabPendiente ? "true" : "false")"
                @onclick="@(() => CambiarTabAsync(TabPendiente))">@L["Apr_TabPending"] (@_countPendientes)</button>
        <button type="button" role="tab" class="@TabClass(TabAprobado)"
                aria-selected="@(_tab == TabAprobado ? "true" : "false")"
                @onclick="@(() => CambiarTabAsync(TabAprobado))">@L["Apr_TabApproved"]</button>
        <button type="button" role="tab" class="@TabClass(TabRechazado)"
                aria-selected="@(_tab == TabRechazado ? "true" : "false")"
                @onclick="@(() => CambiarTabAsync(TabRechazado))">@L["Apr_TabRejected"]</button>
    </div>

    <KpgCard Class="approval-card">
        @* ── Periodo + filtros ──────────────────────────────── *@
        <div class="approval-filters" role="group" aria-label="@L["Common_Filters"]">
            <div class="approval-period">
                <span class="approval-period__label">@L["Label_Period"]</span>
                <div class="approval-period__nav">
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small"
                                   Disabled="_isLoading"
                                   aria-label="@L["Apr_PreviousPeriod"]"
                                   title="@L["Apr_PreviousPeriod"]"
                                   OnClick="@(() => DesplazarPeriodoAsync(-1))" />
                    <span class="approval-period__range">@_desde.ToString("dd/MM/yyyy") – @_hasta.ToString("dd/MM/yyyy")</span>
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small"
                                   Disabled="_isLoading"
                                   aria-label="@L["Apr_NextPeriod"]"
                                   title="@L["Apr_NextPeriod"]"
                                   OnClick="@(() => DesplazarPeriodoAsync(1))" />
                </div>
            </div>
            <div class="approval-filters__field">
                <MudSelect T="string" Label="@L["Label_Employee"]" Variant="Variant.Outlined"
                           Margin="Margin.Dense" Clearable="true"
                           Value="_filtroUserId" ValueChanged="OnFiltroUsuarioAsync"
                           aria-label="@L["Label_Employee"]">
                    @foreach (var u in _empleados)
                    {
                        <MudSelectItem Value="@u.UserId">@u.Nombre</MudSelectItem>
                    }
                </MudSelect>
            </div>
            <div class="approval-filters__field">
                <MudSelect T="int?" Label="@L["Label_Client"]" Variant="Variant.Outlined"
                           Margin="Margin.Dense" Clearable="true"
                           Value="_filtroClienteId" ValueChanged="OnFiltroClienteAsync"
                           aria-label="@L["Label_Client"]">
                    @foreach (var c in _clientes)
                    {
                        <MudSelectItem T="int?" Value="@c.Id">@c.Nombre</MudSelectItem>
                    }
                </MudSelect>
            </div>
            <div class="approval-filters__field">
                <MudSelect T="int?" Label="@L["Label_Project"]" Variant="Variant.Outlined"
                           Margin="Margin.Dense" Clearable="true"
                           Value="_filtroProyectoId" ValueChanged="OnFiltroProyectoAsync"
                           Disabled="@(_filtroClienteId is null)"
                           aria-label="@L["Label_Project"]"
                           title="@(_filtroClienteId is null ? L["Reg_SelectClientFirst"].Value : null)">
                    @foreach (var p in ProyectosDelCliente)
                    {
                        <MudSelectItem T="int?" Value="@p.Id">@p.Nombre</MudSelectItem>
                    }
                </MudSelect>
            </div>
            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                       Class="approval-filters__clear"
                       Disabled="_isLoading"
                       OnClick="LimpiarFiltrosAsync">
                @L["Common_ClearFilters"]
            </MudButton>
        </div>

        @* ── Bandeja ───────────────────────────────────────── *@
        @if (_isLoading)
        {
            <div class="approval-card__state"><KpgTableSkeleton Rows="6" /></div>
        }
        else if (_respuesta.Dias.Count == 0)
        {
            <KpgEmptyState Icon="@Icons.Material.Outlined.DoneAll"
                           Title="@EmptyTitle"
                           Description="@L["Apr_NothingPendingHint"]" />
        }
        else
        {
            <div class="approval-table-scroll">
                <table class="approval-table">
                    <thead>
                        <tr>
                            <th class="approval-table__check" scope="col">
                                @if (RegistrosAccionables.Count > 0)
                                {
                                    <MudCheckBox T="bool" Dense="true" Size="Size.Small"
                                                 Value="@TodosSeleccionados"
                                                 ValueChanged="SeleccionarTodos"
                                                 aria-label="@L["Apr_SelectAll"]" />
                                }
                            </th>
                            <th scope="col">@L["Label_Employee"]</th>
                            <th scope="col">@L["Label_Date"]</th>
                            <th scope="col" class="approval-table__num">@L["Label_Hours"]</th>
                            <th scope="col">@L["Label_Project"]</th>
                            <th scope="col">@L["Label_Description"]</th>
                            <th scope="col">@L["Label_Status"]</th>
                            <th scope="col" class="approval-table__actions">@L["Label_Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var dia in _respuesta.Dias)
                        {
                            @foreach (var r in dia.Registros)
                            {
                                var accionable = EsAccionable(r);
                                <tr class="@(_seleccionados.Contains(r.Id) ? "approval-table__row--selected" : null)">
                                    <td class="approval-table__check">
                                        @if (accionable)
                                        {
                                            <MudCheckBox T="bool" Dense="true" Size="Size.Small"
                                                         Value="@_seleccionados.Contains(r.Id)"
                                                         ValueChanged="@(v => Seleccionar(r.Id, v))"
                                                         aria-label="@string.Format(L["Apr_SelectRecord"], dia.NombreEmpleado, r.Cliente, r.Proyecto)" />
                                        }
                                    </td>
                                    <td>
                                        <span class="approval-table__person">
                                            <span class="kpg-avatar" aria-hidden="true">@Iniciales(dia.NombreEmpleado)</span>
                                            <span class="approval-table__name">@dia.NombreEmpleado</span>
                                        </span>
                                    </td>
                                    <td class="approval-table__nowrap">@dia.Fecha.ToString("ddd dd/MM/yyyy")</td>
                                    <td class="approval-table__num">@KpgFormat.HorasMinutos(r.TotalMinutos) h</td>
                                    <td>
                                        <span class="approval-table__primary">@r.Proyecto</span>
                                        <span class="approval-table__secondary">@r.Cliente · @r.Recurso · @r.Modalidad</span>
                                    </td>
                                    <td class="approval-table__description">
                                        <span class="approval-table__clamp" title="@r.Descripcion">@r.Descripcion</span>
                                        @if (!string.IsNullOrWhiteSpace(r.ComentarioRechazo))
                                        {
                                            <span class="approval-table__reject-reason"><b>@L["Apr_RejectReason"]:</b> @r.ComentarioRechazo</span>
                                        }
                                    </td>
                                    <td><KpgEstadoAprobacionChip Estado="@r.Estado" NivelPendiente="@r.NivelPendiente" /></td>
                                    <td class="approval-table__actions">
                                        @if (accionable)
                                        {
                                            <MudTooltip Text="@L["Apr_ApproveRecord"]">
                                                <MudIconButton Icon="@Icons.Material.Filled.Check" Size="Size.Small"
                                                               Variant="Variant.Filled" Color="Color.Success"
                                                               Class="approval-table__btn"
                                                               Disabled="_isProcesando"
                                                               aria-label="@($"{L["Apr_ApproveRecord"].Value}: {dia.NombreEmpleado} {dia.Fecha:dd/MM}")"
                                                               OnClick="@(() => AprobarDiaAsync(dia, [r]))" />
                                            </MudTooltip>
                                            <MudTooltip Text="@L["Apr_Reject"]">
                                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                                               Variant="Variant.Filled" Color="Color.Error"
                                                               Class="approval-table__btn"
                                                               Disabled="_isProcesando"
                                                               aria-label="@($"{L["Apr_Reject"].Value}: {dia.NombreEmpleado} {dia.Fecha:dd/MM}")"
                                                               OnClick="@(() => RechazarDiaAsync(dia, [r]))" />
                                            </MudTooltip>
                                            @* Tercera salida del revisor: si la descripcion es floja pero el
                                               dia esta bien, la corrige aqui en vez de devolver el registro
                                               y esperar a que el empleado lo reenvie. *@
                                            <MudTooltip Text="@L["Apr_EditDescription"]">
                                                <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small"
                                                               Color="Color.Primary"
                                                               Disabled="_isProcesando"
                                                               aria-label="@L["Apr_EditDescription"]"
                                                               OnClick="@(() => EditarDescripcionAsync(r))" />
                                            </MudTooltip>
                                        }
                                        else if (PuedeRevertir(r))
                                        {
                                            <MudTooltip Text="@(r.Estado == EstadoAprobacion.Rechazado
                                                                ? L["Apr_UndoReject"].Value
                                                                : L["Apr_UndoApprove"].Value)">
                                                <MudIconButton Icon="@Icons.Material.Filled.Undo"
                                                               Size="Size.Small"
                                                               Color="Color.Warning"
                                                               Disabled="_isProcesando"
                                                               aria-label="@(r.Estado == EstadoAprobacion.Rechazado ? L["Apr_UndoReject"] : L["Apr_UndoApprove"])"
                                                               OnClick="@(() => RevertirAsync(r))" />
                                            </MudTooltip>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <div class="approval-card__footer">
                <span>@string.Format(L["Apr_Summary"], _respuesta.TotalRegistros, KpgFormat.Horas(_respuesta.TotalHoras, 1))</span>
            </div>
        }
    </KpgCard>
</section>

@code {
    private BreadcrumbItem[] _breadcrumbs => [
        new(L["Nav_Home"].Value, "/"),
        new(L["Apr_Title"].Value, null, disabled: true)
    ];

    private PendientesAprobacionResponse _respuesta = new(default, default, 0, 0, []);
    /// <summary>
    /// Solo a quienes este revisor les aprueba algun nivel. Antes se cargaba la lista
    /// completa de usuarios: se podia filtrar por gente que nunca iba a aparecer, y le
    /// exponia a un supervisor los nombres de todo el personal.
    /// </summary>
    private List<EmpleadoRevisableResponse> _empleados = [];
    private List<ClienteConProyectosResponse> _clientes = [];

    private DateOnly _desde;
    private DateOnly _hasta;
    private string? _filtroUserId;
    private int? _filtroClienteId;
    private int? _filtroProyectoId;
    private const string TabPendiente = "pendiente";
    private const string TabAprobado = "aprobado";
    private const string TabRechazado = "rechazado";
    private string _tab = TabPendiente;
    private bool _isLoading = true;
    private bool _isProcesando;
    private HashSet<int> _seleccionados = [];
    /// <summary>Conteo del tab "Pendientes", independiente de cuál tab está activo: se
    /// calcula sobre la respuesta sin filtrar, antes de recortarla al tab visible.</summary>
    private int _countPendientes;

    private List<RegistroPendienteResponse> RegistrosAccionables =>
        _respuesta.Dias.SelectMany(d => d.Registros).Where(EsAccionable).ToList();

    private void Seleccionar(int id, bool seleccionado)
    {
        if (seleccionado) _seleccionados.Add(id); else _seleccionados.Remove(id);
    }

    private bool TodosSeleccionados =>
        RegistrosAccionables.Count > 0 && RegistrosAccionables.All(r => _seleccionados.Contains(r.Id));

    private void SeleccionarTodos(bool seleccionar)
    {
        if (seleccionar) _seleccionados.UnionWith(RegistrosAccionables.Select(r => r.Id));
        else _seleccionados.Clear();
    }

    private string EmptyTitle => _tab switch
    {
        TabAprobado  => L["Apr_EmptyApproved"].Value,
        TabRechazado => L["Apr_EmptyRejected"].Value,
        _            => L["Apr_NothingPending"].Value
    };

    private string TabClass(string tab) =>
        _tab == tab ? "approval-tabs__tab approval-tabs__tab--active" : "approval-tabs__tab";

    private static string Iniciales(string nombre) =>
        string.Join("", nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));

    private async Task AprobarSeleccionadosAsync()
    {
        var registros = RegistrosAccionables.Where(r => _seleccionados.Contains(r.Id)).ToList();
        if (registros.Count == 0) return;
        _isProcesando = true;
        try
        {
            var errores = new List<string>();
            foreach (var registro in registros)
            {
                var (ok, _, error) = await Repo.AprobarAsync(registro.Id);
                if (!ok) errores.Add(error ?? L["Apr_ErrorAction"].Value);
            }
            _seleccionados.Clear();
            await CargarAsync();

            if (errores.Count == 0)
                Snackbar.Add(string.Format(L["Apr_ApprovedCount"], registros.Count), Severity.Success);
            else
                Snackbar.Add(string.Format(L["Apr_PartialResult"], registros.Count - errores.Count, registros.Count, errores[0]), Severity.Warning);
        }
        finally { _isProcesando = false; }
    }

    /// <summary>Rechazo masivo: un único comentario cubre toda la selección, así que se
    /// advierte al revisor antes de aplicarlo si abarca más de un cliente/proyecto.</summary>
    private async Task RechazarSeleccionadosAsync()
    {
        var registros = RegistrosAccionables.Where(r => _seleccionados.Contains(r.Id)).ToList();
        if (registros.Count == 0) return;

        var primerDia = _respuesta!.Dias.First(d => d.Registros.Any(r => registros.Contains(r)));
        var parameters = new DialogParameters<KpgRechazoDialog>
        {
            { x => x.NombreEmpleado, string.Format(L["Apr_SelectedCount"], registros.Count) },
            { x => x.Fecha, primerDia.Fecha }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<KpgRechazoDialog>(string.Empty, parameters, options);
        var result = await dialog.Result;
        if (result?.Canceled != false || result.Data is not string comentario)
            return;

        _isProcesando = true;
        try
        {
            var errores = new List<string>();
            foreach (var registro in registros)
            {
                var (ok, _, error) = await Repo.RechazarAsync(registro.Id, comentario);
                if (!ok) errores.Add(error ?? L["Apr_ErrorAction"].Value);
            }
            _seleccionados.Clear();
            await CargarAsync();

            if (errores.Count == 0)
                Snackbar.Add(L["Apr_RejectedOk"].Value, Severity.Success);
            else
                Snackbar.Add(string.Format(L["Apr_PartialResult"], registros.Count - errores.Count, registros.Count, errores[0]), Severity.Warning);
        }
        finally { _isProcesando = false; }
    }

    /// <summary>7 o 14 según <c>PeriodoAprobacion</c>; se lee al iniciar.</summary>
    private int _diasPorPeriodo = 7;

    /// <summary>Ancho real del rango mostrado, que es lo que se desplaza al navegar.</summary>
    private int DiasPeriodo => _hasta.DayNumber - _desde.DayNumber + 1;

    private IEnumerable<ProyectoActivoResponse> ProyectosDelCliente =>
        _clientes.FirstOrDefault(c => c.Id == _filtroClienteId)?.ProyectosActivos
        ?? Enumerable.Empty<ProyectoActivoResponse>();

    /// <summary>Solo se puede actuar sobre lo que está esperando a este revisor ahora mismo.</summary>
    private static bool EsAccionable(RegistroPendienteResponse r) =>
        r.NivelPendiente is not null && r.NivelPendiente == r.NivelDelRevisor;

    /// <summary>
    /// Revertir corresponde a quien actuó: un rechazo lo deshace quien rechazó, y una
    /// aprobación quien aprobó ese nivel. El backend lo vuelve a comprobar.
    /// </summary>
    private static bool PuedeRevertir(RegistroPendienteResponse r) =>
        r.Estado == EstadoAprobacion.Rechazado
        || (int)r.Estado == r.NivelDelRevisor;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var empleados = Repo.GetEmpleadosRevisablesAsync();
            var clientes  = ClienteRepo.GetCatalogoAsync();
            var periodo   = ParametroRepo.GetPeriodoAprobacionAsync();
            await Task.WhenAll(empleados, clientes, periodo);
            _empleados = await empleados;
            _clientes = await clientes;
            _diasPorPeriodo = string.Equals(await periodo, "Quincenal", StringComparison.OrdinalIgnoreCase) ? 14 : 7;
        }
        catch { /* los filtros quedan vacíos; la revisión sigue siendo usable */ }

        // El periodo arranca en el lunes de la semana en curso; si el corte es quincenal
        // abarca dos semanas desde ahi.
        var hoy = DateOnly.FromDateTime(DateTime.Today);
        _desde = hoy.AddDays(-(((int)hoy.DayOfWeek + 6) % 7));
        _hasta = _desde.AddDays(_diasPorPeriodo - 1);

        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        _isLoading = true;
        try
        {
            var respuesta = await Repo.GetPendientesAsync(
                _desde, _hasta, _filtroUserId, _filtroClienteId, _filtroProyectoId,
                incluirRevisados: _tab != TabPendiente);

            _countPendientes = respuesta.Dias.SelectMany(d => d.Registros).Count(EsAccionable);

            _respuesta = _tab switch
            {
                TabAprobado  => FiltrarPorEstado(respuesta, EstadoAprobacion.Aprobado),
                TabRechazado => FiltrarPorEstado(respuesta, EstadoAprobacion.Rechazado),
                _            => respuesta
            };
        }
        catch { Snackbar.Add(L["Apr_ErrorLoad"].Value, Severity.Error); }
        finally { _isLoading = false; }
    }

    /// <summary>El backend no separa aprobados/rechazados en la carga; se filtra acá y se
    /// descartan los días que se quedan sin registros tras el filtro.</summary>
    private static PendientesAprobacionResponse FiltrarPorEstado(PendientesAprobacionResponse respuesta, EstadoAprobacion estado)
    {
        var dias = respuesta.Dias
            .Select(d =>
            {
                var registros = d.Registros.Where(r => r.Estado == estado).ToList();
                return d with { Registros = registros, TotalMinutos = registros.Sum(r => r.TotalMinutos) };
            })
            .Where(d => d.Registros.Count > 0)
            .ToList();
        return respuesta with
        {
            Dias = dias,
            TotalRegistros = dias.Sum(d => d.Registros.Count),
            TotalHoras = dias.Sum(d => d.Registros.Sum(r => r.TotalMinutos)) / 60m
        };
    }

    private async Task DesplazarPeriodoAsync(int direccion)
    {
        var dias = DiasPeriodo * direccion;
        _desde = _desde.AddDays(dias);
        _hasta = _hasta.AddDays(dias);
        await CargarAsync();
    }

    private async Task LimpiarFiltrosAsync()
    {
        _filtroUserId     = null;
        _filtroClienteId  = null;
        _filtroProyectoId = null;
        await VolverAlPeriodoActualAsync();
    }

    private async Task VolverAlPeriodoActualAsync()
    {
        var hoy = DateOnly.FromDateTime(DateTime.Today);
        _desde = hoy.AddDays(-(((int)hoy.DayOfWeek + 6) % 7));
        _hasta = _desde.AddDays(_diasPorPeriodo - 1);
        await CargarAsync();
    }

    private async Task CambiarTabAsync(string tab)
    {
        if (_tab == tab) return;
        _tab = tab;
        _seleccionados.Clear();
        await CargarAsync();
    }

    private async Task OnFiltroUsuarioAsync(string? valor)
    {
        _filtroUserId = valor;
        await CargarAsync();
    }

    private async Task OnFiltroClienteAsync(int? valor)
    {
        _filtroClienteId = valor;
        _filtroProyectoId = null;   // el proyecto anterior ya no pertenece a este cliente
        await CargarAsync();
    }

    private async Task OnFiltroProyectoAsync(int? valor)
    {
        _filtroProyectoId = valor;
        await CargarAsync();
    }

    /// <summary>
    /// Aprueba solo los registros del día que le corresponden a este revisor: un día
    /// puede repartirse entre proyectos con supervisores distintos.
    /// </summary>
    private async Task AprobarDiaAsync(DiaPendienteResponse dia, List<RegistroPendienteResponse> accionables)
    {
        _isProcesando = true;
        try
        {
            var errores = new List<string>();
            foreach (var r in accionables)
            {
                var (ok, _, error) = await Repo.AprobarAsync(r.Id);
                if (!ok) errores.Add(error ?? L["Apr_ErrorAction"].Value);
            }

            if (errores.Count == 0)
                Snackbar.Add(string.Format(L["Apr_ApprovedOk"], dia.NombreEmpleado), Severity.Success);
            else
                Snackbar.Add(string.Format(L["Apr_PartialResult"], accionables.Count - errores.Count, accionables.Count, errores[0]), Severity.Warning);

            await CargarAsync();
        }
        finally { _isProcesando = false; }
    }

    private async Task RechazarDiaAsync(DiaPendienteResponse dia, List<RegistroPendienteResponse> accionables)
    {
        var parameters = new DialogParameters<KpgRechazoDialog>
        {
            { x => x.NombreEmpleado, dia.NombreEmpleado },
            { x => x.Fecha, dia.Fecha }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };

        var dialog = await DialogService.ShowAsync<KpgRechazoDialog>(string.Empty, parameters, options);
        var result = await dialog.Result;
        if (result?.Canceled != false || result.Data is not string comentario)
            return;

        _isProcesando = true;
        try
        {
            var errores = new List<string>();
            foreach (var r in accionables)
            {
                var (ok, _, error) = await Repo.RechazarAsync(r.Id, comentario);
                if (!ok) errores.Add(error ?? L["Apr_ErrorAction"].Value);
            }

            if (errores.Count == 0)
                Snackbar.Add(L["Apr_RejectedOk"].Value, Severity.Success);
            else
                Snackbar.Add(string.Format(L["Apr_PartialResult"], accionables.Count - errores.Count, accionables.Count, errores[0]), Severity.Warning);

            await CargarAsync();
        }
        finally { _isProcesando = false; }
    }

    /// <summary>
    /// Corrige la descripcion sin sacar al registro de la cadena. Los horarios y el
    /// proyecto no se tocan: el revisor aclara lo que dice el dia, no lo reescribe.
    /// El backend revalida que quien edita sea uno de los tres supervisores del registro.
    /// </summary>
    private async Task EditarDescripcionAsync(RegistroPendienteResponse registro)
    {
        var parameters = new DialogParameters<KpgEditDescripcionDialog>
        {
            { x => x.DescripcionActual, registro.Descripcion ?? string.Empty },
            { x => x.SoloDescripcion,   true }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };

        var dialog = await DialogService.ShowAsync<KpgEditDescripcionDialog>(
            L["Apr_EditDescription"].Value, parameters, options);
        var result = await dialog.Result;

        if (result is not { Canceled: false, Data: KpgEditDescripcionDialog.EdicionRegistro edicion })
            return;

        _isProcesando = true;
        try
        {
            var ok = await RegistroHorasRepo.UpdateDescripcionAsync(registro.Id, edicion.Descripcion);
            if (ok)
            {
                Snackbar.Add(L["Apr_DescriptionUpdated"].Value, Severity.Success);
                await CargarAsync();
            }
            else
            {
                Snackbar.Add(L["Apr_EditError"].Value, Severity.Error);
            }
        }
        catch { Snackbar.Add(L["Apr_EditError"].Value, Severity.Error); }
        finally { _isProcesando = false; }
    }

    private async Task RevertirAsync(RegistroPendienteResponse registro)
    {
        _isProcesando = true;
        try
        {
            var (ok, _, error) = registro.Estado == EstadoAprobacion.Rechazado
                ? await Repo.RevertirRechazoAsync(registro.Id)
                : await Repo.RevertirAprobacionAsync(registro.Id);

            if (ok) Snackbar.Add(L["Apr_UndoneOk"].Value, Severity.Success);
            else    Snackbar.Add(error ?? L["Apr_ErrorAction"].Value, Severity.Error);

            await CargarAsync();
        }
        finally { _isProcesando = false; }
    }
}
