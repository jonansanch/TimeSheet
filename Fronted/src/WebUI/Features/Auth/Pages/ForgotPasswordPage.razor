@page "/forgot-password"
@layout LoginLayout
@inject IAuthRepository AuthRepo
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["FP_Title"] — KPG Timesheet</PageTitle>

<section class="auth-form" aria-labelledby="forgot-password-title">
    <header class="auth-form__header">
        <span class="auth-form__icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Filled.LockReset" /></span>
        <MudText Typo="Typo.h4" HtmlTag="h1" Class="auth-form__title" id="forgot-password-title">@L["FP_Title"]</MudText>
        <MudText Typo="Typo.body2" Class="auth-form__subtitle">@L["FP_Subtitle"]</MudText>
    </header>

    @if (_enviado)
    {
        <MudAlert Severity="Severity.Success" role="status" Class="mb-4">@L["FP_Sent"]</MudAlert>
        <KpgButton Variant="Variant.Outlined" FullWidth="true" OnClick="@(() => Nav.NavigateTo("/login"))">
            @L["FP_BackToLogin"]
        </KpgButton>
    }
    else
    {
        <MudForm @ref="_form" @bind-IsValid="_formIsValid">
            <MudStack Spacing="3">
                @if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Dense="true" aria-live="polite">@_errorMessage</MudAlert>
                }
                <MudTextField T="string" @bind-Value="_email" Label="@L["Label_Email"]"
                              InputType="InputType.Email" Required="true" RequiredError="@L["Login_EmailRequired"]"
                              Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Email"
                              Disabled="@_enviando" autocomplete="email" />
                <KpgButton FullWidth="true" Disabled="@(!_formIsValid || _enviando)" OnClick="EnviarAsync">
                    @if (_enviando) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                    @L["FP_SendLink"]
                </KpgButton>
                <MudLink Href="/login" Typo="Typo.body2" Class="auth-form__link">@L["FP_BackToLogin"]</MudLink>
            </MudStack>
        </MudForm>
    }
</section>

@code {
    private MudForm _form = default!;
    private string _email = string.Empty;
    private bool _formIsValid;
    private bool _enviando;
    private bool _enviado;
    private string? _errorMessage;

    private async Task EnviarAsync()
    {
        await _form.Validate();
        if (!_formIsValid) return;
        _enviando = true;
        _errorMessage = null;
        try
        {
            await AuthRepo.ForgotPasswordAsync(_email);
            _enviado = true;
        }
        catch { _errorMessage = L["Error_Unexpected"]; }
        finally { _enviando = false; }
    }
}
