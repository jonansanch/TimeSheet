@page "/reset-password"
@layout LoginLayout
@inject IAuthRepository AuthRepo
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["RP_Title"] — KPG Timesheet</PageTitle>

<section class="auth-form" aria-labelledby="reset-password-title">
    <header class="auth-form__header">
        <span class="auth-form__icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Filled.LockOpen" /></span>
        <MudText Typo="Typo.h4" HtmlTag="h1" Class="auth-form__title" id="reset-password-title">@L["RP_Title"]</MudText>
    </header>

    @if (_tokenInvalido)
    {
        <MudAlert Severity="Severity.Error" aria-live="polite" Class="mb-4">@L["RP_InvalidLink"]</MudAlert>
        <KpgButton Variant="Variant.Outlined" FullWidth="true" OnClick="@(() => Nav.NavigateTo("/forgot-password"))">@L["RP_RequestNew"]</KpgButton>
    }
    else if (_exito)
    {
        <MudAlert Severity="Severity.Success" role="status" Class="mb-4">@L["RP_Success"]</MudAlert>
        <KpgButton FullWidth="true" OnClick="@(() => Nav.NavigateTo("/login"))">@L["FP_BackToLogin"]</KpgButton>
    }
    else
    {
        <MudForm @ref="_form" @bind-IsValid="_formIsValid">
            <MudStack Spacing="3">
                @if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Dense="true" aria-live="polite">@_errorMessage</MudAlert>
                }
                <MudTextField T="string" @bind-Value="_newPassword" Label="@L["Profile_NewPassword"]"
                              InputType="@_inputType" Required="true" RequiredError="@L["Profile_Required"]"
                              Variant="Variant.Outlined" Adornment="Adornment.End" AdornmentIcon="@_visibilityIcon"
                              OnAdornmentClick="ToggleVisibility" Disabled="@_procesando" autocomplete="new-password" />
                <MudTextField T="string" @bind-Value="_confirmPassword" Label="@L["Profile_ConfirmPassword"]"
                              InputType="@_inputType" Required="true"
                              Validation="@((string v) => v == _newPassword ? null : L["Profile_PasswordMismatch"].Value)"
                              Variant="Variant.Outlined" Disabled="@_procesando" autocomplete="new-password" />
                <KpgButton FullWidth="true" Disabled="@(!_formIsValid || _procesando)" OnClick="ResetearAsync">
                    @if (_procesando) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                    @L["RP_Submit"]
                </KpgButton>
            </MudStack>
        </MudForm>
    }
</section>

@code {
    [SupplyParameterFromQuery] public string? Email { get; set; }
    [SupplyParameterFromQuery] public string? Token { get; set; }
    private MudForm _form = default!;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private bool _formIsValid;
    private bool _procesando;
    private bool _exito;
    private bool _tokenInvalido;
    private string? _errorMessage;
    private InputType _inputType = InputType.Password;
    private string _visibilityIcon = Icons.Material.Filled.Visibility;

    protected override void OnInitialized()
    {
        if (string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Token)) _tokenInvalido = true;
    }

    private void ToggleVisibility()
    {
        _inputType = _inputType == InputType.Password ? InputType.Text : InputType.Password;
        _visibilityIcon = _inputType == InputType.Password ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;
    }

    private async Task ResetearAsync()
    {
        await _form.Validate();
        if (!_formIsValid) return;
        _procesando = true;
        _errorMessage = null;
        try
        {
            var (ok, error) = await AuthRepo.ResetPasswordAsync(Email!, Token!, _newPassword);
            if (ok) _exito = true;
            else _errorMessage = error ?? L["RP_InvalidLink"];
        }
        catch { _errorMessage = L["Error_Unexpected"]; }
        finally { _procesando = false; }
    }
}
