<span class="@CssClass" @attributes="AdditionalAttributes">
    @if (!string.IsNullOrWhiteSpace(Icon))
    {
        <MudIcon Icon="@Icon" Size="Size.Small" aria-hidden="true" />
    }
    <span>@Text</span>
</span>

@code {
    [Parameter, EditorRequired] public string Text { get; set; } = string.Empty;
    [Parameter] public string? Status { get; set; } = "neutral";
    [Parameter] public string? Icon { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => $"kpg-status-badge kpg-status-badge--{NormalizedStatus}";
    private string NormalizedStatus => Status?.Trim().ToLowerInvariant() switch
    {
        "success" => "success",
        "warning" => "warning",
        "error" => "error",
        "info" => "info",
        _ => "neutral"
    };
}
