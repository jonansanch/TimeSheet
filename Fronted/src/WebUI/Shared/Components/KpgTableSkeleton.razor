@inject IStringLocalizer<SharedResource> L

<div class="kpg-table-skeleton" aria-busy="true" aria-label="@L["Loading"]">
    @for (var i = 0; i < Math.Max(1, Rows); i++)
    {
        <MudSkeleton Width="100%" Height="48px" SkeletonType="SkeletonType.Rectangle" Class="kpg-table-skeleton__row" />
    }
</div>

@code {
    [Parameter] public int Rows { get; set; } = 5;
}
