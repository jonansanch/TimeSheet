@inject IStringLocalizer<SharedResource> L

<MudTooltip Text="@Texto">
    <KpgStatusBadge Text="@Texto"
                    Status="@(Activo ? "success" : "neutral")"
                    Icon="@(Activo ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.RemoveCircleOutline)" />
</MudTooltip>

@code {
    [Parameter, EditorRequired] public bool Activo { get; set; }

    private string Texto => Activo ? L["Label_Active"].Value : L["Label_Inactive"].Value;
}
