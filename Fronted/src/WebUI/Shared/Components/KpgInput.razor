@typeparam TValue

<MudTextField T="TValue" @attributes="AdditionalAttributes" Value="@Value" ValueChanged="@ValueChanged" For="@For" Label="@Label"
              Placeholder="@Placeholder" HelperText="@HelperText" Required="@Required"
              Disabled="@Disabled" ReadOnly="@ReadOnly" Immediate="@Immediate"
              Lines="@Lines" Variant="Variant.Outlined" Margin="Margin.Dense"
              Class="@CssClass" />

@code {
    [Parameter] public TValue? Value { get; set; }
    [Parameter] public EventCallback<TValue?> ValueChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? HelperText { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Immediate { get; set; }
    [Parameter] public int Lines { get; set; } = 1;
    [Parameter] public System.Linq.Expressions.Expression<Func<TValue>>? For { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
    private string CssClass => $"kpg-input {Class}".Trim();
}
