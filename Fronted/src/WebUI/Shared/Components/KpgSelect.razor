@typeparam TValue

<MudSelect T="TValue" @attributes="AdditionalAttributes" Value="@Value" ValueChanged="@ValueChanged" For="@For" Label="@Label"
           HelperText="@HelperText" Required="@Required" Disabled="@Disabled"
           Clearable="@Clearable" Variant="Variant.Outlined" Margin="Margin.Dense"
           Class="@CssClass">
    @ChildContent
</MudSelect>

@code {
    [Parameter] public TValue? Value { get; set; }
    [Parameter] public EventCallback<TValue?> ValueChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? HelperText { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Clearable { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public System.Linq.Expressions.Expression<Func<TValue>>? For { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
    private string CssClass => $"kpg-select {Class}".Trim();
}
