{
  // Los valores reales NO van aqui. En local usa appsettings.Development.json
  // o dotnet user-secrets; en Azure usa Connection strings / App settings.
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  // La API key de Gemini NO va aqui: se parametriza desde la pantalla de administracion
  // (ParametroSistema, clave "GeminiApiKey"), justamente para poder renovarla sin desplegar.
  "Gemini": {
    "Model": "gemini-flash-latest",
    "MaxTokens": 1024
  },
  // "Mejorar redaccion" con IA. Reusa la misma API key de arriba: no hace falta repetirla
  // aqui. Vacio en todos los campos significa "usar los valores por defecto del codigo".
  "GeminiRedactorDescripcion": {
    "Model": "gemini-flash-lite-latest",
    "MaxTokens": 512,
    "LimiteDiarioPorUsuario": 20
  },
  "Jwt": {
    "Key": "",
    "Issuer": "KPG.Timesheet.Api",
    "Audience": "KPG.Timesheet.WebUI",
    "ExpirationMinutes": 60,
    "RefreshExpirationHours": 8,
    "SessionWarningMinutes": 5
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "FromAddress": "noreply@kpg-timesheet.com",
    "FromName": "KPG Timesheet",
    "UserName": "",
    "Password": "",
    "EnableSsl": true
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/kpg-timesheet-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ]
  }
}
